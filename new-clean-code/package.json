{
  "name": "lessonstudio",
  "version": "0.1.0",
  "type": "module",
  "description": "A high-level language for interactive lessons \u2014 Manim, in the browser, interactive. One replayable IR, three ways to drive it: authored, taught live, or taught by a model.",
  "license": "MIT",
  "keywords": [
    "interactive-lessons",
    "explorable-explanations",
    "animation",
    "statechart",
    "education",
    "manim",
    "svg",
    "react",
    "llm",
    "tutor"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "tsx checks/run.ts",
    "dev": "vite"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.165.0",
    "@vitejs/plugin-react": "^6.0.3",
    "puppeteer": "^25.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.1.0"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "katex": "^0.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.165.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.30.0"
  }
