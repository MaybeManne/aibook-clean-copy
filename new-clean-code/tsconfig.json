{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@lessonstudio/state-machine": ["state_machine/index.ts"],
      "@lessonstudio/intents": ["intents/index.ts"],
      "@lessonstudio/timeline": ["timeline/index.ts"],
      "@lessonstudio/figures": ["figures/index.ts"],
      "@lessonstudio/audio": ["audio/index.ts"],
      "@lessonstudio/lesson": ["lesson/index.ts"],
      "@lessonstudio/authoring": ["authoring/index.ts"],
      "@lessonstudio/teach": ["teach/index.ts"],
      "@lessonstudio/forge": ["forge/index.ts"],
      "@lessonstudio/live": ["live/index.ts"],
      "@lessonstudio/theme": ["theme/index.ts"],
      "@lessonstudio/svg": ["svg/index.ts"],
      "@lessonstudio/machine": ["machine/index.ts"],
      "@lessonstudio/web": ["web/index.ts"]
    }
  },
  "include": ["state_machine", "intents", "timeline", "figures", "audio", "lesson", "authoring", "teach", "forge", "live", "theme", "svg", "machine", "web", "examples", "dev", "checks"]
}
