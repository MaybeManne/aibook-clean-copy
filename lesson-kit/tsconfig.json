{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@lessonkit/state-machine": ["state_machine/index.ts"],
      "@lessonkit/render-contract": ["render_contract/index.ts"],
      "@lessonkit/timeline": ["timeline/index.ts"],
      "@lessonkit/lesson": ["lesson/index.ts"],
      "@lessonkit/template": ["template/index.ts"],
      "@lessonkit/render-web": ["rendering/render_web/index.ts"]
    }
  },
  "include": ["state_machine", "render_contract", "timeline", "lesson", "template", "rendering", "examples"]
}
