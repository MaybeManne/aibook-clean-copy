PORT=3003

# Defaults are repo-local:
# ACTIVE_READER_CONTENT_ROOT=../../../content/visionbook-qmd
# ACTIVE_READER_DEMO_DIR=../../../content/active-reader-demo
# CHAPTER_GRAPHS_DIR=../../../content/chapter_graphs
# FIGURE_RESULTS_DIR=../../../content/figure-results

# Optional. Required only for chat/scoring routes that call Claude.
ANTHROPIC_API_KEY=

# Optional. Required only for embedding/RAG routes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional. Override the bundled generated figure cache.
# FIGURE_RESULTS_DIR=/path/to/generated/figure-results

# Optional. Used for server-side HTML screenshots/thumbnails.
PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
