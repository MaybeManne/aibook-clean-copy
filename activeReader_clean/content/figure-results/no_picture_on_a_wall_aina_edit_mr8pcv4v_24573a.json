{
  "id": "no_picture_on_a_wall_aina_edit_mr8pcv4v_24573a",
  "filename": "no_picture_on_a_wall_aina.html",
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n  <meta charset=\"UTF-8\" />\n  <title>Figure</title>\n  <style>\n    html,\n    body {\n      margin: 0;\n      padding: 0;\n      width: 100%;\n      height: 100%;\n      overflow: hidden;\n      background: #fff;\n    }\n\n    #c {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n\n    .lbl {\n      position: absolute;\n      pointer-events: none;\n      transform: translate(-50%, -50%);\n      white-space: nowrap;\n      font-family: sans-serif;\n      font-size: 13px;\n      color: #111;\n    }\n\n    #ui {\n      position: absolute;\n      left: 6px;\n      bottom: 6px;\n      display: flex;\n      flex-direction: column;\n      gap: 3px;\n      font-family: sans-serif;\n      font-size: 11px;\n      max-width: 190px;\n      max-height: 34%;\n      background: transparent;\n      border: 0;\n      box-shadow: none;\n      opacity: 0.88;\n      transform: none;\n      transition: opacity 0.16s ease;\n      z-index: 10;\n    }\n\n    #ui:hover,\n    #ui:focus-within {\n      opacity: 1;\n    }\n\n    #ui button {\n      padding: 4px 10px;\n      cursor: pointer;\n      border: 1px solid #aaa;\n      background: #f5f5f5;\n      border-radius: 4px;\n    }\n\n    #ui button:hover {\n      background: #e0e0e0;\n    }\n\n    #ui button.active {\n      background: #c8e6ff;\n      border-color: #5aabf0;\n    }\n\n    #ui label {\n      display: flex;\n      flex-direction: column;\n      gap: 2px;\n      text-shadow: 0 1px 2px #fff;\n    }\n\n    #ui input[type=range] {\n      width: 86px;\n    }\n\n    #figTooltip {\n      position: fixed;\n      left: 0;\n      top: 0;\n      display: none;\n      max-width: 210px;\n      padding: 4px 8px;\n      border-radius: 4px;\n      background: rgba(0, 0, 0, 0.58);\n      color: #fff;\n      font: 11px/1.35 sans-serif;\n      pointer-events: none;\n      white-space: normal;\n      z-index: 20;\n    }\n  </style>\n</head>\n\n<body>\n  <canvas id=\"c\"></canvas>\n  <div id=\"figTooltip\"></div>\n  <div id=\"ui\">\n    <button id=\"btnReset\" style=\"display:none\">Reset View</button>\n    <!-- @FIGURE_UI_BEGIN -->\n<label>Wall distance <span id=\"wallVal\">2.0</span>\n  <input id=\"moveProjectionWall\" type=\"range\" min=\"1\" max=\"4\" step=\"0.1\" value=\"2\">\n</label>\n<label>Tree distance <span id=\"treeVal\">4.0</span>\n  <input id=\"moveTree\" type=\"range\" min=\"2\" max=\"6\" step=\"0.1\" value=\"4\">\n</label>\n<!-- @FIGURE_UI_END -->\n  </div>\n\n  <script type=\"importmap\">\n  {\n    \"imports\": {\n      \"three\": \"https://cdn.jsdelivr.net/npm/three@0.171.0/build/three.module.js\",\n      \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@0.171.0/examples/jsm/\"\n    }\n  }\n  </script>\n\n  <div id=\"err-overlay\" style=\"display:none;position:fixed;inset:0;background:#fff;z-index:999;\n       display:flex;flex-direction:column;align-items:center;justify-content:center;\n       font-family:sans-serif;font-size:13px;color:#555;gap:10px;\">\n    <span id=\"err-msg\">⚠ Figure failed to load</span>\n    <button onclick=\"location.reload()\" style=\"padding:5px 14px;border:1px solid #aaa;\n        border-radius:5px;background:#f5f5f5;cursor:pointer;font-size:12px;\">↻ Reload</button>\n  </div>\n\n  <script>\n    let _rendered = false;\n    const _errOverlay = document.getElementById('err-overlay');\n    window.__markRendered = () => { _rendered = true; _errOverlay.style.display = 'none'; };\n    window.addEventListener('error', (e) => {\n      if (!_rendered) {\n        document.getElementById('err-msg').textContent = '⚠ ' + (e.message || 'Figure failed to load');\n        _errOverlay.style.display = 'flex';\n      }\n    });\n    setTimeout(() => {\n      if (!_rendered) { _errOverlay.style.display = 'flex'; }\n    }, 12000);\n  </script>\n\n  <script type=\"module\">\n    import * as THREE from 'three';\n    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';\n\n    const canvas = document.getElementById('c');\n    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });\n\n    const scene = new THREE.Scene();\n    scene.background = new THREE.Color(0xffffff);\n\n    const d = 3;\n    let aspect = canvas.clientWidth / canvas.clientHeight;\n    let camera = new THREE.OrthographicCamera(\n      -d * aspect, d * aspect, d, -d, 0.1, 100\n    );\n    camera.position.set(4, 4, 4);\n    camera.lookAt(0, 0, 0);\n    camera.updateProjectionMatrix();\n\n    const controls = new OrbitControls(camera, renderer.domElement);\n    controls.enableDamping = true;\n    controls.dampingFactor = 0.05;\n\n    const HOME_POS = new THREE.Vector3();\n    const HOME_TARGET = new THREE.Vector3(0, 0, 0);\n    let HOME_ZOOM = 0.75;\n\n    document.getElementById('btnReset').addEventListener('click', () => {\n      camera.position.copy(HOME_POS);\n      controls.target.copy(HOME_TARGET);\n      camera.zoom = HOME_ZOOM;\n      camera.updateProjectionMatrix();\n      controls.update();\n    });\n\n    const FRAME_HALF_HEIGHT = d;\n    const FRAME_MARGIN = 0.08;\n    const MIN_ZOOM = 0.2;\n    const MAX_ZOOM = 5;\n\n    function computeSceneBounds() {\n      const box = new THREE.Box3().setFromObject(scene);\n      if (box.isEmpty()) {\n        box.setFromCenterAndSize(new THREE.Vector3(0, 0, 0), new THREE.Vector3(2 * d, 2 * d, 2 * d));\n      }\n      const center = new THREE.Vector3();\n      box.getCenter(center);\n      const size = new THREE.Vector3();\n      box.getSize(size);\n      return { box, center, size };\n    }\n\n    function setCameraView({\n      projection = 'orthographic',\n      azimuthDeg = 45,\n      elevationDeg = 35,\n      rollDeg = 0,\n      zoom = null,\n      target = null,\n      heightFraction = 0.5,\n      distanceScale = 1.2\n    } = {}) {\n      const { center, size } = computeSceneBounds();\n      const viewTarget = Array.isArray(target)\n        ? new THREE.Vector3(target[0] || 0, target[1] || 0, target[2] || 0)\n        : center;\n\n      const contentHeight = Math.max(size.y, 1e-6);\n      const desiredViewHeight = contentHeight / Math.max(heightFraction, 0.01);\n      let resolvedZoom = Number.isFinite(zoom) ? zoom : (2 * FRAME_HALF_HEIGHT) / desiredViewHeight;\n      resolvedZoom = Math.min(Math.max(resolvedZoom, MIN_ZOOM), MAX_ZOOM);\n      camera.zoom = resolvedZoom;\n\n      const radius = Math.max(size.length() * distanceScale, FRAME_HALF_HEIGHT * 2);\n      const azimuth = THREE.MathUtils.degToRad(azimuthDeg);\n      const elevation = THREE.MathUtils.degToRad(elevationDeg);\n      const cosElev = Math.cos(elevation);\n      const x = viewTarget.x + radius * Math.cos(azimuth) * cosElev;\n      const y = viewTarget.y + radius * Math.sin(elevation);\n      const z = viewTarget.z + radius * Math.sin(azimuth) * cosElev;\n      camera.position.set(x, y, z);\n\n      controls.target.copy(viewTarget);\n      camera.up.set(0, 1, 0);\n      if (Number.isFinite(rollDeg) && rollDeg !== 0) {\n        const viewDir = new THREE.Vector3().subVectors(viewTarget, camera.position).normalize();\n        camera.up.applyAxisAngle(viewDir, THREE.MathUtils.degToRad(rollDeg));\n      }\n      camera.updateProjectionMatrix();\n      controls.update();\n\n      HOME_POS.copy(camera.position);\n      HOME_TARGET.copy(controls.target);\n      HOME_ZOOM = camera.zoom;\n\n      window.__figureCameraView = {\n        projection,\n        azimuthDeg,\n        elevationDeg,\n        rollDeg,\n        zoom: camera.zoom,\n        target: [controls.target.x, controls.target.y, controls.target.z],\n      };\n    }\n\n    function setStandardView({ azimuth = Math.PI / 4, polar = Math.PI / 4, heightFraction = 0.5 } = {}) {\n      const azimuthDeg = THREE.MathUtils.radToDeg(azimuth);\n      const elevationDeg = 90 - THREE.MathUtils.radToDeg(polar);\n      setCameraView({ azimuthDeg, elevationDeg, heightFraction });\n    }\n\n    setStandardView();\n\n    const _labels = [];\n    const _v = new THREE.Vector3();\n\n    function addLabel(text, position, options = {}) {\n      const div = document.createElement('div');\n      div.className = 'lbl';\n      div.innerHTML = text;\n      if (options.color) div.style.color = options.color;\n      if (options.fontSize) div.style.fontSize = options.fontSize;\n      if (options.bold) div.style.fontWeight = 'bold';\n      if (options.background) {\n        div.style.background = options.background;\n        div.style.padding = '1px 4px';\n        div.style.borderRadius = '3px';\n      }\n      document.body.appendChild(div);\n      const entry = { div, pos: position.clone(), offset: options.offset || [0, 0] };\n      _labels.push(entry);\n      return entry;\n    }\n\n    const _referenceDistance = 8;\n\n    function _syncLabels() {\n      for (const { div, pos, offset } of _labels) {\n        _v.copy(pos).project(camera);\n\n        if (_v.z > 1 || _v.z < -1 || _v.x < -1 || _v.x > 1 || _v.y < -1 || _v.y > 1) {\n          div.style.display = 'none';\n          continue;\n        }\n        div.style.display = '';\n\n        const ox = offset && offset[0] ? offset[0] : 0;\n        const oy = offset && offset[1] ? offset[1] : 0;\n        const x = (_v.x * 0.5 + 0.5) * canvas.clientWidth + ox;\n        const y = (-_v.y * 0.5 + 0.5) * canvas.clientHeight + oy;\n\n        let scale;\n        const distance = Math.max(camera.position.distanceTo(pos), 1e-4);\n        scale = (_referenceDistance / distance) * (camera.zoom || 1);\n        scale = Math.max(0.5, Math.min(scale, 6));\n\n        div.style.left = x + 'px';\n        div.style.top = y + 'px';\n        div.style.transform = `translate(-50%, -50%) scale(${scale})`;\n      }\n    }\n\n    const _tooltip = document.getElementById('figTooltip');\n    const _raycaster = new THREE.Raycaster();\n    const _pointer = new THREE.Vector2();\n    const _interactiveObjects = [];\n    let _hoveredInteractive = null;\n\n    function showPopup(title, body) {\n      window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n    }\n\n    function hidePopup() {\n      window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n    }\n\n    function showTooltip(text, event) {\n      if (!_tooltip || !text) return;\n      _tooltip.textContent = text;\n      _tooltip.style.display = 'block';\n      moveTooltip(event);\n    }\n\n    function moveTooltip(event) {\n      if (!_tooltip || _tooltip.style.display === 'none') return;\n      const pad = 12;\n      const x = Math.min(event.clientX + pad, window.innerWidth - _tooltip.offsetWidth - pad);\n      const y = Math.max(pad, event.clientY - _tooltip.offsetHeight - pad);\n      _tooltip.style.left = x + 'px';\n      _tooltip.style.top = y + 'px';\n    }\n\n    function hideTooltip() {\n      if (_tooltip) _tooltip.style.display = 'none';\n    }\n\n    function _setPointerFromEvent(event) {\n      const rect = canvas.getBoundingClientRect();\n      _pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;\n      _pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;\n    }\n\n    function _firstInteractiveHit(event) {\n      if (!_interactiveObjects.length) return null;\n      _setPointerFromEvent(event);\n      _raycaster.setFromCamera(_pointer, camera);\n      const hits = _raycaster.intersectObjects(_interactiveObjects.map(entry => entry.object), true);\n      for (const hit of hits) {\n        let obj = hit.object;\n        while (obj) {\n          const entry = _interactiveObjects.find(item => item.object === obj);\n          if (entry) return { ...entry, hit };\n          obj = obj.parent;\n        }\n      }\n      return null;\n    }\n\n    function registerInteractive(object, info = {}) {\n      if (!object) return object;\n      object.userData = object.userData || {};\n      object.userData.interactive = true;\n      _interactiveObjects.push({ object, info });\n      return object;\n    }\n\n    canvas.addEventListener('pointermove', (event) => {\n      moveTooltip(event);\n      const entry = _firstInteractiveHit(event);\n      if (entry) {\n        _hoveredInteractive = entry;\n        canvas.style.cursor = 'pointer';\n        showTooltip(entry.info.tooltip || entry.info.title || 'Click to explain', event);\n      } else {\n        _hoveredInteractive = null;\n        canvas.style.cursor = controls.enabled ? 'grab' : 'default';\n        hideTooltip();\n      }\n    });\n\n    canvas.addEventListener('pointerleave', () => {\n      _hoveredInteractive = null;\n      canvas.style.cursor = 'default';\n      hideTooltip();\n    });\n\n    canvas.addEventListener('click', (event) => {\n      const entry = _firstInteractiveHit(event) || _hoveredInteractive;\n      if (!entry) {\n        hidePopup();\n        return;\n      }\n      const title = entry.info.title || entry.info.tooltip || 'Figure element';\n      const body = entry.info.body || entry.info.description || 'This part is interactive.';\n      showPopup(title, body);\n      if (typeof entry.info.onClick === 'function') entry.info.onClick(entry.hit, entry.object);\n    });\n\n    window.addEventListener('keydown', (event) => {\n      if (event.key === 'Escape') {\n        hidePopup();\n        hideTooltip();\n      }\n    });\n\n    // Animation loop with time tracking\n    let _firstFrame = true;\n    let _animTime = 0;\n    let _lastTime = 0;\n\n    function animate(now = 0) {\n      requestAnimationFrame(animate);\n      const dt = Math.min((now - _lastTime) / 1000, 0.05);\n      _lastTime = now;\n      _animTime += dt;\n      controls.update();\n      // Update animated rays if callback registered\n      if (window._updateAnimatedRays) window._updateAnimatedRays(_animTime);\n      renderer.render(scene, camera);\n      _syncLabels();\n      if (_firstFrame) { _firstFrame = false; window.__markRendered?.(); }\n    }\n    animate();\n\n    new ResizeObserver(() => {\n      const w = canvas.clientWidth, h = canvas.clientHeight;\n      aspect = w / h;\n      camera.left = -d * aspect;\n      camera.right = d * aspect;\n      camera.updateProjectionMatrix();\n      renderer.setSize(w, h, false);\n    }).observe(canvas);\n\n    // @FIGURE_CODE_BEGIN\nscene.background = new THREE.Color(0xffffff);\nrenderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));\n\nconst state = {\n  moveProjectionWall: 2,\n  moveTree: 4\n};\n\nconst COLORS = {\n  black: 0x000000,\n  green: 0x39ff00,\n  darkGreen: 0x169400,\n  midGreen: 0x1fc400,\n  imageGreen: 0x7dff55,\n  trunk: 0x815025,\n  wall: 0xffffff,\n  blur: 0xd8d8d8\n};\n\n// Increased separation: left scene centered around -5.5, right around +4.5\nconst leftOffset = -5.5;\nconst rightOffset = 3.5;\n\n// Left wall is 2 units to the left of left scene center\nconst leftWallLocalX = -2.0;\n// Left tree is 2 units to the right of left scene center\nconst leftTreeLocalX = 2.2;\n\n// Pinhole is at x=0 in right scene (local), centered\nconst pinholeLocalX = 0.0;\n// Pinhole Y = 0: centered vertically\nconst pinholeY = 0.0;\n\n// Wall dimensions - sized so tree fits comfortably inside\nconst wallZWidth = 3.8;\nconst wallYMin = -1.8;\nconst wallYMax = 1.8;\n\nconst wallSlider = document.getElementById('moveProjectionWall');\nconst treeSlider = document.getElementById('moveTree');\nconst wallVal = document.getElementById('wallVal');\nconst treeVal = document.getElementById('treeVal');\n\nfunction makeMat(color, opacity = 1, side = THREE.DoubleSide) {\n  return new THREE.MeshBasicMaterial({\n    color,\n    transparent: opacity < 1,\n    opacity,\n    side,\n    depthWrite: opacity >= 0.98\n  });\n}\n\nfunction cylinderBetween(a, b, radius, color, opacity = 1) {\n  const dir = new THREE.Vector3().subVectors(b, a);\n  const len = dir.length();\n  if (len < 1e-6) return new THREE.Group();\n  const geom = new THREE.CylinderGeometry(radius, radius, len, 12, 1);\n  const mesh = new THREE.Mesh(geom, makeMat(color, opacity));\n  mesh.position.copy(a).add(b).multiplyScalar(0.5);\n  mesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), dir.clone().normalize());\n  return mesh;\n}\n\nfunction coneArrowAt(end, from, radius, height, color, opacity = 1) {\n  const dir = new THREE.Vector3().subVectors(end, from).normalize();\n  const geom = new THREE.ConeGeometry(radius, height, 18);\n  const cone = new THREE.Mesh(geom, makeMat(color, opacity));\n  cone.position.copy(end).addScaledVector(dir, -height * 0.5);\n  cone.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), dir);\n  return cone;\n}\n\n// Animated ray: uses a moving sphere \"pulse\" along the ray path\nfunction makeAnimatedRay(a, b, color, radius = 0.014, opacity = 1) {\n  const g = new THREE.Group();\n\n  // Static cylinder body\n  const shaft = cylinderBetween(a, b, radius, color, opacity * 0.55);\n  g.add(shaft);\n\n  // Static arrowhead at end\n  g.add(coneArrowAt(b, a, radius * 3.8, radius * 12, color, opacity));\n\n  // Animated pulse sphere travelling from a to b\n  const pulse = new THREE.Mesh(\n    new THREE.SphereGeometry(radius * 2.8, 10, 6),\n    makeMat(color, opacity)\n  );\n  pulse.userData.rayA = a.clone();\n  pulse.userData.rayB = b.clone();\n  g.add(pulse);\n  g.userData.isPulseGroup = true;\n\n  return g;\n}\n\n// Non-animated version for static parts\nfunction makeRay(a, b, color, radius = 0.014, opacity = 1) {\n  const g = new THREE.Group();\n  g.add(cylinderBetween(a, b, radius, color, opacity));\n  g.add(coneArrowAt(b, a, radius * 3.8, radius * 12, color, opacity));\n  return g;\n}\n\nfunction marker(pos, color, r = 0.055, opacity = 1) {\n  const m = new THREE.Mesh(new THREE.SphereGeometry(r, 16, 10), makeMat(color, opacity));\n  m.position.copy(pos);\n  return m;\n}\n\nfunction clearGroup(g) {\n  while (g.children.length) g.remove(g.children[0]);\n}\n\nfunction makeWallGroup() {\n  const g = new THREE.Group();\n  const plane = new THREE.Mesh(\n    new THREE.PlaneGeometry(wallZWidth, wallYMax - wallYMin),\n    makeMat(COLORS.wall, 0.05)\n  );\n  plane.rotation.y = Math.PI / 2;\n  plane.position.set(0, (wallYMin + wallYMax) / 2, 0);\n  g.add(plane);\n\n  const z0 = -wallZWidth / 2, z1 = wallZWidth / 2;\n  const corners = [\n    new THREE.Vector3(0, wallYMin, z0),\n    new THREE.Vector3(0, wallYMax, z0),\n    new THREE.Vector3(0, wallYMax, z1),\n    new THREE.Vector3(0, wallYMin, z1)\n  ];\n  for (let i = 0; i < 4; i++) {\n    g.add(cylinderBetween(corners[i], corners[(i + 1) % 4], 0.022, COLORS.black));\n  }\n  return g;\n}\n\nfunction makePinholePlane() {\n  const z0 = -wallZWidth / 2;\n  const z1 = wallZWidth / 2;\n  const y0 = wallYMin;\n  const y1 = wallYMax;\n\n  const shape = new THREE.Shape();\n  shape.moveTo(z0, y0);\n  shape.lineTo(z1, y0);\n  shape.lineTo(z1, y1);\n  shape.lineTo(z0, y1);\n  shape.lineTo(z0, y0);\n\n  // Pinhole hole at y=0 (centered)\n  const hole = new THREE.Path();\n  hole.absellipse(0, pinholeY, 0.13, 0.13, 0, Math.PI * 2, true);\n  shape.holes.push(hole);\n\n  const geom = new THREE.ShapeGeometry(shape, 32);\n  const mesh = new THREE.Mesh(geom, makeMat(COLORS.black, 1));\n  mesh.rotation.y = Math.PI / 2;\n\n  const g = new THREE.Group();\n  g.add(mesh);\n\n  const rim = new THREE.Mesh(\n    new THREE.TorusGeometry(0.135, 0.012, 10, 36),\n    makeMat(0xffffff, 1)\n  );\n  rim.rotation.y = Math.PI / 2;\n  rim.position.set(0.004, pinholeY, 0);\n  g.add(rim);\n\n  const spot = new THREE.Mesh(\n    new THREE.SphereGeometry(0.032, 16, 10),\n    makeMat(0xffffff, 1)\n  );\n  spot.position.set(0.012, pinholeY, 0);\n  g.add(spot);\n\n  return g;\n}\n\n// Scaled-down tree so it fits within wall height (wallYMin=-1.8, wallYMax=1.8)\n// Tree total height ~3.6 units to fit inside the 3.6-unit wall\nfunction createTree(scale = 0.78) {\n  const g = new THREE.Group();\n\n  // Trunk: total height ~2.0 units scaled\n  const trunkH = 2.0 * scale;\n  const trunk = new THREE.Mesh(\n    new THREE.CylinderGeometry(0.18 * scale, 0.30 * scale, trunkH, 18),\n    makeMat(COLORS.trunk)\n  );\n  trunk.position.set(0, (-trunkH * 0.5 + 0.1 * scale), 0);\n  g.add(trunk);\n\n  // Roots\n  const rootBase = new THREE.Vector3(0, -trunkH * 0.5 - 0.4 * scale, 0);\n  const roots = [\n    [rootBase.clone(), new THREE.Vector3(0, rootBase.y - 0.18 * scale, -0.42 * scale)],\n    [rootBase.clone(), new THREE.Vector3(0, rootBase.y - 0.18 * scale, 0.42 * scale)]\n  ];\n  roots.forEach(([a, b]) => g.add(cylinderBetween(a, b, 0.055 * scale, COLORS.trunk)));\n\n  // Branches from top of trunk\n  const trunkTop = trunkH * 0.5 + 0.1 * scale;\n  const branches = [\n    [new THREE.Vector3(0, trunkTop * 0.3, 0), new THREE.Vector3(0, trunkTop * 0.75, -0.55 * scale)],\n    [new THREE.Vector3(0, trunkTop * 0.35, 0), new THREE.Vector3(0, trunkTop * 0.80, 0.55 * scale)],\n    [new THREE.Vector3(0, trunkTop * 0.45, 0), new THREE.Vector3(0, trunkTop, 0.04 * scale)]\n  ];\n  branches.forEach(([a, b]) => g.add(cylinderBetween(a, b, 0.055 * scale, COLORS.trunk)));\n\n  // Foliage spheres - positioned so top doesn't exceed wallYMax\n  const leafGeom = new THREE.SphereGeometry(1, 36, 20);\n  const topY = trunkTop + 0.75 * scale;   // top of topmost leaf ~ trunkTop + radius\n  const leaves = [\n    { p: [0, topY, 0.02 * scale], s: [0.72 * scale, 0.78 * scale, 0.74 * scale], c: COLORS.darkGreen },\n    { p: [0, trunkTop * 0.82, -0.52 * scale], s: [0.62 * scale, 0.68 * scale, 0.64 * scale], c: COLORS.green },\n    { p: [0, trunkTop * 0.80, 0.55 * scale], s: [0.60 * scale, 0.64 * scale, 0.62 * scale], c: COLORS.midGreen }\n  ];\n  leaves.forEach(l => {\n    const m = new THREE.Mesh(leafGeom, makeMat(l.c));\n    m.position.set(l.p[0], l.p[1], l.p[2]);\n    m.scale.set(l.s[0], l.s[1], l.s[2]);\n    g.add(m);\n  });\n\n  return g;\n}\n\n// Ray source points on tree (local to tree group), scaled\nconst sc = 0.78;\nconst trunkH = 2.0 * sc;\nconst trunkTop = trunkH * 0.5 + 0.1 * sc;\nconst raySpecs = [\n  { name: 'upper foliage', local: new THREE.Vector3(0, trunkTop + 0.70 * sc, 0.05 * sc), color: COLORS.darkGreen, radius: 0.016 },\n  { name: 'middle foliage', local: new THREE.Vector3(0, trunkTop * 0.80, -0.48 * sc), color: COLORS.green, radius: 0.016 },\n  { name: 'lower trunk', local: new THREE.Vector3(0, -trunkH * 0.45, 0.02 * sc), color: COLORS.trunk, radius: 0.014 }\n];\n\n// Build scene objects\nconst leftWall = makeWallGroup();\nleftWall.position.set(leftOffset + leftWallLocalX, 0, 0);\nscene.add(leftWall);\n\nconst rightWall = makeWallGroup();\nscene.add(rightWall);\n\nconst leftTree = createTree();\nleftTree.position.set(leftOffset + leftTreeLocalX, 0, 0);\nscene.add(leftTree);\n\nconst rightTree = createTree();\nscene.add(rightTree);\n\nconst pinhole = makePinholePlane();\npinhole.position.set(rightOffset + pinholeLocalX, 0, 0);\nscene.add(pinhole);\n\nconst leftRays = new THREE.Group();\nconst rightRays = new THREE.Group();\nconst projectionImage = new THREE.Group();\nscene.add(leftRays, rightRays, projectionImage);\n\n// Collect all pulse groups for animation\nconst allPulseGroups = [];\n\n// Wall hit points spread across wall face (for left panel - shows many rays going to same wall points)\nconst leftWallX_world = leftOffset + leftWallLocalX;\nconst leftWallEndpoints = [\n  new THREE.Vector3(leftWallX_world + 0.025, 1.25, -0.80),\n  new THREE.Vector3(leftWallX_world + 0.025, 0.15, 0.72),\n  new THREE.Vector3(leftWallX_world + 0.025, -1.10, 0.02)\n];\n\n// Build left panel rays (animated)\nraySpecs.forEach((spec, i) => {\n  const origin = spec.local.clone().add(leftTree.position);\n  leftWallEndpoints.forEach((end, j) => {\n    const opacity = i === j ? 0.95 : 0.50;\n    const rg = makeAnimatedRay(origin, end, spec.color, spec.radius, opacity);\n    leftRays.add(rg);\n    // collect pulse meshes\n    rg.children.forEach(ch => {\n      if (ch.userData.rayA) allPulseGroups.push({ mesh: ch, phaseOffset: (i * 0.37 + j * 0.13) });\n    });\n  });\n  leftRays.add(marker(origin, spec.color, 0.050));\n});\nleftWallEndpoints.forEach((p, i) => leftRays.add(marker(p, raySpecs[i].color, 0.044, 0.85)));\n\n// Labels\nconst pinLabel = addLabel('Pinhole', new THREE.Vector3(rightOffset + pinholeLocalX, wallYMax + 0.32, 0), {\n  fontSize: '28px',\n  color: '#000',\n  offset: [0, -6]\n});\nconst leftWallLabel = addLabel('Wall', new THREE.Vector3(leftOffset + leftWallLocalX - 0.05, wallYMax + 0.22, -wallZWidth / 2 + 0.3), {\n  fontSize: '26px',\n  color: '#000',\n  offset: [-10, 0]\n});\nconst rightWallLabel = addLabel('Wall', new THREE.Vector3(0, wallYMax + 0.22, -wallZWidth / 2 + 0.3), {\n  fontSize: '26px',\n  color: '#000',\n  offset: [-10, 0]\n});\naddLabel('(a)', new THREE.Vector3(leftOffset + 0.10, wallYMin - 0.42, 0.15), {\n  fontSize: '26px',\n  color: '#000',\n  offset: [0, 12]\n});\naddLabel('(b)', new THREE.Vector3(rightOffset + 1.80, wallYMin - 0.42, 0.12), {\n  fontSize: '26px',\n  color: '#000',\n  offset: [0, 12]\n});\n\nfunction addProjectedDisk(y, z, rz, ry, color, opacity) {\n  const mesh = new THREE.Mesh(new THREE.CircleGeometry(1, 48), makeMat(color, opacity));\n  mesh.rotation.y = Math.PI / 2;\n  mesh.position.set(0.04, y, z);\n  mesh.scale.set(rz, ry, 1);\n  mesh.material.depthWrite = false;\n  projectionImage.add(mesh);\n  return mesh;\n}\n\nfunction addProjectedRect(y, z, wz, hy, color, opacity) {\n  const mesh = new THREE.Mesh(new THREE.PlaneGeometry(wz, hy), makeMat(color, opacity));\n  mesh.rotation.y = Math.PI / 2;\n  mesh.position.set(0.045, y, z);\n  mesh.material.depthWrite = false;\n  projectionImage.add(mesh);\n  return mesh;\n}\n\nfunction projectedPoint(localPoint) {\n  // Project through pinhole at (rightOffset + pinholeLocalX, pinholeY, 0)\n  // Pinhole is at x=0 in pinhole-local frame, so:\n  const pinholeWorldX = rightOffset + pinholeLocalX;\n  const treeWorldX = rightTree.position.x;\n  const wallWorldX = pinholeWorldX - state.moveProjectionWall;\n\n  // Distances\n  const dObj = treeWorldX - pinholeWorldX;   // positive: tree is to the right\n  const dImg = pinholeWorldX - wallWorldX;   // positive: wall is to the left\n\n  if (Math.abs(dObj) < 1e-6) return new THREE.Vector3(wallWorldX, pinholeY, 0);\n\n  const factor = -dImg / dObj;\n  return new THREE.Vector3(\n    wallWorldX + 0.04,\n    pinholeY + factor * (localPoint.y - pinholeY),\n    factor * localPoint.z\n  );\n}\n\nfunction rebuildProjectionImage() {\n  clearGroup(projectionImage);\n  const pinholeWorldX = rightOffset + pinholeLocalX;\n  const treeWorldX = rightTree.position.x;\n  const wallWorldX = pinholeWorldX - state.moveProjectionWall;\n  const dObj = treeWorldX - pinholeWorldX;\n  const dImg = pinholeWorldX - wallWorldX;\n  if (Math.abs(dObj) < 1e-6) return;\n  const s = dImg / Math.abs(dObj);\n\n  projectionImage.position.set(0, 0, 0);\n\n  // Leaf features (in local tree coords)\n  const topY = trunkTop + 0.70 * sc;\n  const leafFeatures = [\n    { y: topY, z: 0.05 * sc, rz: 0.74 * sc, ry: 0.78 * sc, c: COLORS.darkGreen, a: 0.36 },\n    { y: trunkTop * 0.80, z: -0.48 * sc, rz: 0.64 * sc, ry: 0.68 * sc, c: COLORS.green, a: 0.32 },\n    { y: trunkTop * 0.80, z: 0.55 * sc, rz: 0.62 * sc, ry: 0.64 * sc, c: COLORS.midGreen, a: 0.32 }\n  ];\n  leafFeatures.forEach(f => {\n    const py = pinholeY - s * (f.y - pinholeY);\n    const pz = -s * f.z;\n    addProjectedDisk(py, pz, Math.max(0.06, f.rz * s), Math.max(0.06, f.ry * s), f.c, f.a);\n  });\n\n  // Trunk\n  const trunkTopY = trunkTop * 0.5;\n  const trunkBotY = -trunkH * 0.45;\n  const projTop = pinholeY - s * (trunkTopY - pinholeY);\n  const projBottom = pinholeY - s * (trunkBotY - pinholeY);\n  addProjectedRect(\n    (projTop + projBottom) / 2,\n    0,\n    Math.max(0.06, 0.30 * sc * s),\n    Math.abs(projTop - projBottom),\n    COLORS.trunk,\n    0.34\n  );\n}\n\n// Right panel animated rays\nconst rightPulseGroups = [];\n\nfunction updateRightRays() {\n  clearGroup(rightRays);\n  rightPulseGroups.length = 0;\n\n  const pinholeWorldX = rightOffset + pinholeLocalX;\n  const pin = new THREE.Vector3(pinholeWorldX, pinholeY, 0);\n\n  raySpecs.forEach((spec, i) => {\n    const origin = spec.local.clone().add(rightTree.position);\n    const end = projectedPoint(spec.local);\n\n    const segment1End = pin.clone().add(new THREE.Vector3(0.018, 0, 0));\n    const segment2Start = pin.clone().add(new THREE.Vector3(-0.018, 0, 0));\n\n    // Animated ray from tree to pinhole\n    const rg1 = makeAnimatedRay(origin, segment1End, spec.color, spec.radius, 0.95);\n    rightRays.add(rg1);\n    rg1.children.forEach(ch => {\n      if (ch.userData.rayA) rightPulseGroups.push({ mesh: ch, phaseOffset: i * 0.4 + 0.0 });\n    });\n\n    // Animated ray from pinhole to wall\n    const rg2 = makeAnimatedRay(segment2Start, end, spec.color, spec.radius, 0.95);\n    rightRays.add(rg2);\n    rg2.children.forEach(ch => {\n      if (ch.userData.rayA) rightPulseGroups.push({ mesh: ch, phaseOffset: i * 0.4 + 0.5 });\n    });\n\n    rightRays.add(marker(origin, spec.color, 0.048));\n    rightRays.add(marker(end, spec.color, 0.042, 0.92));\n  });\n\n  rightRays.add(marker(pin, 0xffffff, 0.032));\n}\n\n// Animation callback: move pulse spheres along their rays\nwindow._updateAnimatedRays = function(t) {\n  const speed = 0.6; // cycles per second\n\n  // Left panel pulses\n  allPulseGroups.forEach(({ mesh, phaseOffset }) => {\n    const a = mesh.userData.rayA;\n    const b = mesh.userData.rayB;\n    if (!a || !b) return;\n    const u = ((t * speed + phaseOffset) % 1.0 + 1.0) % 1.0;\n    mesh.position.lerpVectors(a, b, u);\n  });\n\n  // Right panel pulses\n  rightPulseGroups.forEach(({ mesh, phaseOffset }) => {\n    const a = mesh.userData.rayA;\n    const b = mesh.userData.rayB;\n    if (!a || !b) return;\n    const u = ((t * speed + phaseOffset) % 1.0 + 1.0) % 1.0;\n    mesh.position.lerpVectors(a, b, u);\n  });\n};\n\nfunction updateScene() {\n  state.moveProjectionWall = parseFloat(wallSlider.value);\n  state.moveTree = parseFloat(treeSlider.value);\n  wallVal.textContent = state.moveProjectionWall.toFixed(1);\n  treeVal.textContent = state.moveTree.toFixed(1);\n\n  const pinholeWorldX = rightOffset + pinholeLocalX;\n  rightTree.position.set(pinholeWorldX + state.moveTree, 0, 0);\n  rightWall.position.set(pinholeWorldX - state.moveProjectionWall, 0, 0);\n  rightWallLabel.pos.set(pinholeWorldX - state.moveProjectionWall - 0.05, wallYMax + 0.22, -wallZWidth / 2 + 0.3);\n\n  rebuildProjectionImage();\n  updateRightRays();\n}\n\nwallSlider.addEventListener('input', updateScene);\ntreeSlider.addEventListener('input', updateScene);\nupdateScene();\n\nregisterInteractive(leftWall, {\n  title: 'Ordinary wall',\n  tooltip: 'Panel (a): many rays overlap at every wall point',\n  body: 'Without a pinhole, each patch of the wall receives light from many different parts of the tree. The colors and directions overlap, so the wall is illuminated but no sharp picture appears.'\n});\n\nregisterInteractive(rightWall, {\n  title: 'Projection wall',\n  tooltip: 'Panel (b): the wall receives separated directions',\n  body: 'Behind the pinhole, each position on the wall corresponds to a particular direction through the hole. Moving the wall farther away magnifies the projected tree image.'\n});\n\nregisterInteractive(leftTree, {\n  title: 'Scene object',\n  tooltip: 'Tree points emit/scatter light in many directions',\n  body: 'Each point on the tree sends light toward many wall positions. Panel (a) shows why this unrestricted bundle does not by itself form an image on a plain wall.'\n});\n\nregisterInteractive(rightTree, {\n  title: 'Object distance',\n  tooltip: 'Move the tree distance slider to change projection size',\n  body: 'Changing the tree distance changes the ray geometry through the pinhole. A closer object projects a larger image because the rays spread out more after crossing the hole.'\n});\n\nregisterInteractive(projectionImage, {\n  title: 'Projected image',\n  tooltip: 'Faint inverted image on the wall',\n  body: 'The projected tree is upside-down and left-right reversed because the rays cross at the pinhole. Points high on the tree land