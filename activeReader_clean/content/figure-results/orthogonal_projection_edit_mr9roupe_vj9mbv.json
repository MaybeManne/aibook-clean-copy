{
  "id": "orthogonal_projection_edit_mr9roupe_vj9mbv",
  "filename": "orthogonal_projection.html",
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n  <meta charset=\"UTF-8\" />\n  <title>Figure</title>\n  <style>\n    html,\n    body {\n      margin: 0;\n      padding: 0;\n      width: 100%;\n      height: 100%;\n      overflow: hidden;\n      background: #fff;\n    }\n\n    #c {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n\n    .lbl {\n      position: absolute;\n      pointer-events: none;\n      transform: translate(-50%, -50%);\n      white-space: nowrap;\n      font-family: sans-serif;\n      font-size: 13px;\n      color: #111;\n    }\n\n    #ui {\n      position: absolute;\n      top: 10px;\n      left: 10px;\n      display: flex;\n      flex-direction: column;\n      gap: 6px;\n      font-family: sans-serif;\n      font-size: 13px;\n    }\n\n    #ui button {\n      padding: 4px 10px;\n      cursor: pointer;\n      border: 1px solid #aaa;\n      background: #f5f5f5;\n      border-radius: 4px;\n    }\n\n    #ui button:hover {\n      background: #e0e0e0;\n    }\n\n    #ui button.active {\n      background: #c8e6ff;\n      border-color: #5aabf0;\n    }\n\n    #ui label {\n      display: flex;\n      flex-direction: column;\n      gap: 2px;\n    }\n\n    #ui input[type=range] {\n      width: 140px;\n    }\n  </style>\n</head>\n\n<body>\n  <canvas id=\"c\"></canvas>\n  <div id=\"ui\">\n    <button id=\"btnReset\">Reset View</button>\n    <!-- @FIGURE_UI_BEGIN -->\n<label>\n  Object Z-depth: <span id=\"objectDepthValue\">3.0</span>\n  <input id=\"objectDepthSlider\" type=\"range\" min=\"1\" max=\"5\" step=\"0.1\" value=\"3\">\n</label>\n<label>\n  Global scale (k): <span id=\"scalingValue\">1.00</span>\n  <input id=\"scalingSlider\" type=\"range\" min=\"0.5\" max=\"2\" step=\"0.05\" value=\"1\">\n</label>\n<label>\n  Object rotation (Y): <span id=\"rotationValue\">0°</span>\n  <input id=\"rotationSlider\" type=\"range\" min=\"-180\" max=\"180\" step=\"1\" value=\"0\">\n</label>\n<label style=\"flex-direction:row;align-items:center;gap:6px;\">\n  <input id=\"autoRotateToggle\" type=\"checkbox\">\n  Auto-spin object\n</label>\n<label style=\"flex-direction:row;align-items:center;gap:6px;\">\n  <input id=\"objectShapeToggle\" type=\"checkbox\">\n  Show alternative shape\n</label>\n<div style=\"display:flex;gap:4px;flex-wrap:wrap;width:190px;\">\n  <button id=\"step0\">Step 1</button>\n  <button id=\"step1\">Step 2</button>\n  <button id=\"step2\">Step 3</button>\n  <button id=\"step3\">Step 4</button>\n</div>\n<div id=\"demoTitle\" style=\"max-width:220px;font-weight:bold;background:rgba(255,255,255,0.9);padding:5px 7px;border-radius:4px;border:1px solid rgba(0,0,0,0.10);\"></div>\n<div id=\"demoNarration\" style=\"max-width:220px;line-height:1.25;background:rgba(255,255,255,0.88);padding:6px 7px;border-radius:4px;border:1px solid rgba(0,0,0,0.08);\"></div>\n<!-- @FIGURE_UI_END -->\n  </div>\n\n  <script type=\"importmap\">\n  {\n    \"imports\": {\n      \"three\": \"https://cdn.jsdelivr.net/npm/three@0.171.0/build/three.module.js\",\n      \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@0.171.0/examples/jsm/\"\n    }\n  }\n  </script>\n\n  <div id=\"err-overlay\" style=\"display:none;position:fixed;inset:0;background:#fff;z-index:999;\n       display:flex;flex-direction:column;align-items:center;justify-content:center;\n       font-family:sans-serif;font-size:13px;color:#555;gap:10px;\">\n    <span id=\"err-msg\">⚠ Figure failed to load</span>\n    <button onclick=\"location.reload()\" style=\"padding:5px 14px;border:1px solid #aaa;\n        border-radius:5px;background:#f5f5f5;cursor:pointer;font-size:12px;\">↻ Reload</button>\n  </div>\n\n  <script>\n    let _rendered = false;\n    const _errOverlay = document.getElementById('err-overlay');\n    window.__markRendered = () => { _rendered = true; _errOverlay.style.display = 'none'; };\n    window.addEventListener('error', (e) => {\n      if (!_rendered) {\n        document.getElementById('err-msg').textContent = '⚠ ' + (e.message || 'Figure failed to load');\n        _errOverlay.style.display = 'flex';\n      }\n    });\n    setTimeout(() => {\n      if (!_rendered) { _errOverlay.style.display = 'flex'; }\n    }, 12000);\n  </script>\n\n  <script type=\"module\">\n    import * as THREE from 'three';\n    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';\n\n    const canvas = document.getElementById('c');\n    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });\n\n    const scene = new THREE.Scene();\n    scene.background = new THREE.Color(0xffffff);\n\n    const d = 3;\n    let aspect = canvas.clientWidth / canvas.clientHeight;\n    const camera = new THREE.OrthographicCamera(\n      -d * aspect, d * aspect, d, -d, 0.1, 100\n    );\n    camera.position.set(4, 4, 4);\n    camera.lookAt(0, 0, 0);\n    camera.updateProjectionMatrix();\n\n    const controls = new OrbitControls(camera, renderer.domElement);\n    controls.enableDamping = true;\n    controls.dampingFactor = 0.05;\n    controls.enableRotate = true;\n    controls.enablePan = true;\n    controls.enableZoom = true;\n\n    const HOME_POS = new THREE.Vector3();\n    const HOME_TARGET = new THREE.Vector3(0, 0, 0);\n    let HOME_ZOOM = 0.75;\n\n    document.getElementById('btnReset').addEventListener('click', () => {\n      camera.position.copy(HOME_POS);\n      controls.target.copy(HOME_TARGET);\n      camera.zoom = HOME_ZOOM;\n      camera.updateProjectionMatrix();\n      controls.update();\n    });\n\n    const FRAME_HALF_HEIGHT = d;\n    const FRAME_MARGIN = 0.08;\n    const MIN_ZOOM = 0.2;\n    const MAX_ZOOM = 5;\n\n    function computeSceneBounds() {\n      const box = new THREE.Box3().setFromObject(scene);\n      if (box.isEmpty()) {\n        box.setFromCenterAndSize(new THREE.Vector3(0, 0, 0), new THREE.Vector3(2 * d, 2 * d, 2 * d));\n      }\n      const center = new THREE.Vector3();\n      box.getCenter(center);\n      const size = new THREE.Vector3();\n      box.getSize(size);\n      return { box, center, size };\n    }\n\n    function setStandardView({ azimuth = Math.PI / 4, polar = Math.PI / 4, heightFraction = 0.5 } = {}) {\n      const { center, size } = computeSceneBounds();\n\n      const contentHeight = Math.max(size.y, 1e-6);\n      const desiredViewHeight = contentHeight / Math.max(heightFraction, 0.01);\n      let zoom = (2 * FRAME_HALF_HEIGHT) / desiredViewHeight;\n      zoom = Math.min(Math.max(zoom, MIN_ZOOM), MAX_ZOOM);\n      camera.zoom = zoom;\n\n      const radius = Math.max(size.length() * 1.2, FRAME_HALF_HEIGHT * 2);\n      const sinPhi = Math.sin(polar), cosPhi = Math.cos(polar);\n      const x = center.x + radius * Math.cos(azimuth) * sinPhi;\n      const y = center.y + radius * cosPhi;\n      const z = center.z + radius * Math.sin(azimuth) * sinPhi;\n      camera.position.set(x, y, z);\n\n      controls.target.copy(center);\n      camera.updateProjectionMatrix();\n      controls.update();\n\n      HOME_POS.copy(camera.position);\n      HOME_TARGET.copy(controls.target);\n      HOME_ZOOM = camera.zoom;\n    }\n\n    setStandardView();\n\n    const _labels = [];\n    const _v = new THREE.Vector3();\n\n    function addLabel(text, position, options = {}) {\n      const div = document.createElement('div');\n      div.className = 'lbl';\n      div.innerHTML = text;\n      if (options.color) div.style.color = options.color;\n      if (options.fontSize) div.style.fontSize = options.fontSize;\n      if (options.bold) div.style.fontWeight = 'bold';\n      if (options.background) {\n        div.style.background = options.background;\n        div.style.padding = '1px 4px';\n        div.style.borderRadius = '3px';\n      }\n      document.body.appendChild(div);\n      const entry = { div, pos: position.clone(), offset: options.offset || [0, 0] };\n      _labels.push(entry);\n      return entry;\n    }\n\n    const _referenceDistance = 8;\n\n    function _syncLabels() {\n      for (const { div, pos, offset } of _labels) {\n        _v.copy(pos).project(camera);\n\n        if (_v.z > 1 || _v.z < -1 || _v.x < -1 || _v.x > 1 || _v.y < -1 || _v.y > 1) {\n          div.style.display = 'none';\n          continue;\n        }\n        div.style.display = '';\n\n        const ox = offset && offset[0] ? offset[0] : 0;\n        const oy = offset && offset[1] ? offset[1] : 0;\n        const x = (_v.x * 0.5 + 0.5) * canvas.clientWidth + ox;\n        const y = (-_v.y * 0.5 + 0.5) * canvas.clientHeight + oy;\n\n        let scale;\n        const distance = Math.max(camera.position.distanceTo(pos), 1e-4);\n        scale = (_referenceDistance / distance) * (camera.zoom || 1);\n        scale = Math.max(0.5, Math.min(scale, 6));\n\n        div.style.left = x + 'px';\n        div.style.top = y + 'px';\n        div.style.transform = `translate(-50%, -50%) scale(${scale})`;\n      }\n    }\n\n    let _firstFrame = true;\n    function animate() {\n      requestAnimationFrame(animate);\n\n      // Auto-spin the object group around Y axis (left-right)\n      if (state && state.autoRotate) {\n        state.objectRotation += 0.008;\n        if (state.objectRotation > Math.PI) state.objectRotation -= 2 * Math.PI;\n        const deg = Math.round(state.objectRotation * 180 / Math.PI);\n        document.getElementById('rotationSlider').value = deg;\n        document.getElementById('rotationValue').textContent = deg + '°';\n        updateScene();\n      }\n\n      controls.update();\n      renderer.render(scene, camera);\n      _syncLabels();\n      if (_firstFrame) { _firstFrame = false; window.__markRendered?.(); }\n    }\n    setTimeout(animate, 0);\n\n    new ResizeObserver(() => {\n      const w = canvas.clientWidth, h = canvas.clientHeight;\n      aspect = w / h;\n      camera.left = -d * aspect;\n      camera.right = d * aspect;\n      camera.updateProjectionMatrix();\n      renderer.setSize(w, h, false);\n    }).observe(canvas);\n\n    // @FIGURE_CODE_BEGIN\nrenderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));\n\nconst state = {\n  objectDepth: 3,\n  scale: 1,\n  altShape: false,\n  objectRotation: 0,   // radians, rotation around Y axis (left-right)\n  autoRotate: false\n};\n\nconst uiDepth = document.getElementById('objectDepthSlider');\nconst uiScale = document.getElementById('scalingSlider');\nconst uiShape = document.getElementById('objectShapeToggle');\nconst uiDepthValue = document.getElementById('objectDepthValue');\nconst uiScaleValue = document.getElementById('scalingValue');\nconst uiDemoTitle = document.getElementById('demoTitle');\nconst uiDemoNarration = document.getElementById('demoNarration');\nconst uiRotation = document.getElementById('rotationSlider');\nconst uiRotationValue = document.getElementById('rotationValue');\nconst uiAutoRotate = document.getElementById('autoRotateToggle');\nconst stepButtons = [0, 1, 2, 3].map(i => document.getElementById(`step${i}`));\n\nconst root = new THREE.Group();\nconst staticGroup = new THREE.Group();\nconst projectionGroup = new THREE.Group();\nconst rayGroup = new THREE.Group();\nconst objectGroup = new THREE.Group();\n// pivot group: allows rotating the stair around its own center along Y axis\nconst objectPivot = new THREE.Group();\nobjectPivot.add(objectGroup);\nroot.add(staticGroup, projectionGroup, rayGroup, objectPivot);\nscene.add(root);\n\nconst colors = {\n  black: 0x111318,\n  green: 0x31ff00,\n  red: 0xff3214,\n  cyan: 0x51cde8,\n  plane: 0xe9eef0,\n  grid: 0x6f777c\n};\n\nconst planeZ = 0;\nconst planeMinX = -1.05;\nconst planeMaxX = 4.25;\nconst planeMinY = -1.55;\nconst planeMaxY = 4.35;\nconst baseX = 0.34;\nconst cellW = 0.58;\nconst objectLengthZ = 2.65;\n\nconst matBlack = new THREE.LineBasicMaterial({ color: colors.black });\nconst matEdge = new THREE.LineBasicMaterial({ color: colors.black, depthTest: true });\nconst matGrid = new THREE.LineBasicMaterial({ color: colors.grid, transparent: true, opacity: 0.18, depthWrite: false });\nconst matRay = new THREE.LineDashedMaterial({\n  color: colors.black,\n  dashSize: 0.095,\n  gapSize: 0.06,\n  transparent: true,\n  opacity: 0.98,\n  depthTest: false\n});\nconst matRed = new THREE.MeshBasicMaterial({ color: colors.red, side: THREE.DoubleSide });\nconst matGreen = new THREE.MeshBasicMaterial({ color: colors.green, side: THREE.DoubleSide });\nconst matCyan = new THREE.MeshBasicMaterial({ color: colors.cyan, side: THREE.DoubleSide });\nconst matPlane = new THREE.MeshBasicMaterial({\n  color: colors.plane,\n  transparent: true,\n  opacity: 0.58,\n  side: THREE.DoubleSide,\n  depthWrite: false\n});\nconst matProjRed = new THREE.MeshBasicMaterial({\n  color: colors.red,\n  transparent: true,\n  opacity: 0.72,\n  side: THREE.DoubleSide,\n  depthWrite: false\n});\nconst matProjCyan = new THREE.MeshBasicMaterial({\n  color: colors.cyan,\n  transparent: true,\n  opacity: 0.82,\n  side: THREE.DoubleSide,\n  depthWrite: false\n});\nconst matProjGreen = new THREE.LineBasicMaterial({ color: colors.green, depthTest: false });\nconst matProjCyanLine = new THREE.LineBasicMaterial({ color: colors.cyan, depthTest: false });\n\nfunction makeLine(points, material) {\n  return new THREE.Line(new THREE.BufferGeometry().setFromPoints(points), material);\n}\n\nfunction makeSegments(points, material) {\n  return new THREE.LineSegments(new THREE.BufferGeometry().setFromPoints(points), material);\n}\n\nfunction makeDashedLine(a, b) {\n  const line = makeLine([a, b], matRay);\n  line.computeLineDistances();\n  line.renderOrder = 10;\n  return line;\n}\n\nfunction quadMesh(a, b, c, dd, material) {\n  const g = new THREE.BufferGeometry();\n  g.setAttribute('position', new THREE.Float32BufferAttribute([\n    a.x, a.y, a.z, b.x, b.y, b.z, c.x, c.y, c.z,\n    a.x, a.y, a.z, c.x, c.y, c.z, dd.x, dd.y, dd.z\n  ], 3));\n  g.computeVertexNormals();\n\n  const mesh = new THREE.Mesh(g, material);\n  const edges = new THREE.LineSegments(new THREE.EdgesGeometry(g), matEdge);\n\n  const group = new THREE.Group();\n  group.add(mesh, edges);\n  return group;\n}\n\nfunction clearGroup(group) {\n  while (group.children.length) {\n    const child = group.children[0];\n    group.remove(child);\n    child.traverse?.((o) => {\n      if (o.geometry) o.geometry.dispose();\n    });\n  }\n}\n\nfunction heightsForShape() {\n  return state.altShape ? [0.82, 1.78, 1.12, 2.38] : [0.74, 1.42, 2.12];\n}\n\nfunction stepPolygon2D(heights, k = state.scale) {\n  const pts = [];\n  const sx = x => x * k;\n  const sy = y => y * k;\n\n  pts.push(new THREE.Vector2(sx(baseX), sy(0)));\n  pts.push(new THREE.Vector2(sx(baseX), sy(heights[0])));\n\n  for (let i = 0; i < heights.length; i++) {\n    const xr = baseX + (i + 1) * cellW;\n    pts.push(new THREE.Vector2(sx(xr), sy(heights[i])));\n    if (i < heights.length - 1) pts.push(new THREE.Vector2(sx(xr), sy(heights[i + 1])));\n  }\n\n  pts.push(new THREE.Vector2(sx(baseX + heights.length * cellW), sy(0)));\n  return pts;\n}\n\n// Get all 3D vertices of the step object in its local space (before pivot transform)\nfunction getObjectVertices3D(heights) {\n  const pts = stepPolygon2D(heights, state.scale);\n  const z0 = state.objectDepth;\n  const z1 = state.objectDepth + objectLengthZ;\n  const verts = [];\n  for (const p of pts) {\n    verts.push(new THREE.Vector3(p.x, p.y, z0));\n    verts.push(new THREE.Vector3(p.x, p.y, z1));\n  }\n  return verts;\n}\n\n// Compute center of object for pivot\nfunction computeObjectCenter(heights) {\n  const pts = stepPolygon2D(heights, state.scale);\n  let cx = 0, cy = 0;\n  for (const p of pts) { cx += p.x; cy += p.y; }\n  cx /= pts.length; cy /= pts.length;\n  const cz = state.objectDepth + objectLengthZ / 2;\n  return new THREE.Vector3(cx, cy, cz);\n}\n\n// Apply Y-axis rotation to objectPivot, centered on the object's centroid\nfunction applyObjectRotation(heights) {\n  const center = computeObjectCenter(heights);\n\n  objectPivot.position.set(center.x, center.y, center.z);\n  objectPivot.rotation.set(0, state.objectRotation, 0);\n  objectGroup.position.set(-center.x, -center.y, -center.z);\n}\n\n// Transform a local vertex through the pivot to get world position\nfunction localToWorld(v, center) {\n  // v is in local objectGroup space; objectGroup.position = -center\n  // pivot rotates around Y, then is positioned at center\n  const local = v.clone().sub(center);\n  // Apply Y rotation\n  const cosA = Math.cos(state.objectRotation);\n  const sinA = Math.sin(state.objectRotation);\n  const rx = local.x * cosA + local.z * sinA;\n  const ry = local.y;\n  const rz = -local.x * sinA + local.z * cosA;\n  return new THREE.Vector3(rx + center.x, ry + center.y, rz + center.z);\n}\n\n// Get world-space vertices of the rotated object\nfunction getWorldVertices(heights) {\n  const localVerts = getObjectVertices3D(heights);\n  const center = computeObjectCenter(heights);\n  return localVerts.map(v => localToWorld(v, center));\n}\n\n// Project world vertices onto the projection plane (z = planeZ) by setting z=planeZ\n// Orthographic projection along Z: just take x,y\nfunction projectToPlane(worldVerts) {\n  return worldVerts.map(v => new THREE.Vector2(v.x, v.y));\n}\n\n// Compute convex hull of 2D points (Graham scan)\nfunction convexHull2D(points) {\n  if (points.length < 3) return points.slice();\n  const pts = points.slice().sort((a, b) => a.x !== b.x ? a.x - b.x : a.y - b.y);\n  const cross = (O, A, B) => (A.x - O.x) * (B.y - O.y) - (A.y - O.y) * (B.x - O.x);\n  const lower = [];\n  for (const p of pts) {\n    while (lower.length >= 2 && cross(lower[lower.length - 2], lower[lower.length - 1], p) <= 0)\n      lower.pop();\n    lower.push(p);\n  }\n  const upper = [];\n  for (let i = pts.length - 1; i >= 0; i--) {\n    const p = pts[i];\n    while (upper.length >= 2 && cross(upper[upper.length - 2], upper[upper.length - 1], p) <= 0)\n      upper.pop();\n    upper.push(p);\n  }\n  upper.pop();\n  lower.pop();\n  return lower.concat(upper);\n}\n\nfunction addFigureLabel(text, pos, options = {}) {\n  const entry = addLabel(text, pos, options);\n  entry.div.style.fontFamily = options.family || '\"Times New Roman\", Times, serif';\n  if (options.italic !== false) entry.div.style.fontStyle = 'italic';\n  entry.div.style.textShadow = options.shadow || '0 0 3px rgba(255,255,255,0.85)';\n  return entry;\n}\n\nfunction buildStaticScene() {\n  const plane = new THREE.Mesh(\n    new THREE.PlaneGeometry(planeMaxX - planeMinX, planeMaxY - planeMinY),\n    matPlane\n  );\n  plane.position.set((planeMinX + planeMaxX) / 2, (planeMinY + planeMaxY) / 2, planeZ - 0.018);\n  plane.renderOrder = -2;\n  staticGroup.add(plane);\n\n  const gridPts = [];\n  const gridStep = 0.45;\n  for (let x = planeMinX; x <= planeMaxX + 1e-6; x += gridStep) {\n    gridPts.push(\n      new THREE.Vector3(x, planeMinY, planeZ + 0.004),\n      new THREE.Vector3(x, planeMaxY, planeZ + 0.004)\n    );\n  }\n  for (let y = planeMinY; y <= planeMaxY + 1e-6; y += gridStep) {\n    gridPts.push(\n      new THREE.Vector3(planeMinX, y, planeZ + 0.004),\n      new THREE.Vector3(planeMaxX, y, planeZ + 0.004)\n    );\n  }\n  staticGroup.add(makeSegments(gridPts, matGrid));\n\n  const border = [\n    new THREE.Vector3(planeMinX, planeMinY, planeZ + 0.025),\n    new THREE.Vector3(planeMaxX, planeMinY, planeZ + 0.025),\n    new THREE.Vector3(planeMaxX, planeMaxY, planeZ + 0.025),\n    new THREE.Vector3(planeMinX, planeMaxY, planeZ + 0.025),\n    new THREE.Vector3(planeMinX, planeMinY, planeZ + 0.025)\n  ];\n  staticGroup.add(makeLine(border, matBlack));\n\n  const worldOrigin = new THREE.Vector3(-2.45, -0.06, 0);\n  const axX = new THREE.ArrowHelper(new THREE.Vector3(1, 0, 0), worldOrigin, 2.45, colors.black, 0.26, 0.17);\n  const axY = new THREE.ArrowHelper(new THREE.Vector3(0, 1, 0), worldOrigin, 2.65, colors.black, 0.26, 0.17);\n  const axZ = new THREE.ArrowHelper(new THREE.Vector3(0, 0, 1), worldOrigin, 3.55, colors.black, 0.28, 0.18);\n  staticGroup.add(axX, axY, axZ);\n\n  const imgOrigin = new THREE.Vector3(0, 0, planeZ + 0.115);\n  const imgX = new THREE.ArrowHelper(new THREE.Vector3(1, 0, 0), imgOrigin, 2.55, colors.green, 0.22, 0.14);\n  const imgY = new THREE.ArrowHelper(new THREE.Vector3(0, 1, 0), imgOrigin, 2.55, colors.green, 0.22, 0.14);\n  staticGroup.add(imgX, imgY);\n\n  addFigureLabel('X', new THREE.Vector3(-0.36, -0.02, 0.09), { fontSize: '34px', bold: true, color: '#111' });\n  addFigureLabel('Y', new THREE.Vector3(-2.46, 2.73, 0.07), { fontSize: '34px', bold: true, color: '#111' });\n  addFigureLabel('Z', new THREE.Vector3(-2.37, -0.09, 3.72), { fontSize: '34px', bold: true, color: '#111' });\n\n  addFigureLabel('x', new THREE.Vector3(2.75, 0.20, planeZ + 0.16), { fontSize: '31px', bold: true, color: '#111' });\n  addFigureLabel('y', new THREE.Vector3(0.18, 2.82, planeZ + 0.16), { fontSize: '31px', bold: true, color: '#111' });\n\n  const pp = addFigureLabel('Projection plane', new THREE.Vector3(1.52, -1.92, planeZ + 0.06), {\n    fontSize: '34px',\n    color: '#111',\n    italic: false,\n    background: 'rgba(255,255,255,0.55)'\n  });\n  pp.div.style.fontFamily = '\"Times New Roman\", Times, serif';\n}\n\nfunction addCap(points2, z, material) {\n  const shape = new THREE.Shape(points2);\n  const mesh = new THREE.Mesh(new THREE.ShapeGeometry(shape), material);\n  mesh.position.z = z;\n  objectGroup.add(mesh);\n\n  const outlinePts = points2.map(p => new THREE.Vector3(p.x, p.y, z));\n  outlinePts.push(outlinePts[0].clone());\n  objectGroup.add(makeLine(outlinePts, matEdge));\n}\n\nfunction buildObject(heights) {\n  const pts = stepPolygon2D(heights, state.scale);\n  const z0 = state.objectDepth;\n  const z1 = state.objectDepth + objectLengthZ;\n\n  for (let i = 0; i < pts.length; i++) {\n    const p = pts[i];\n    const q = pts[(i + 1) % pts.length];\n    const a = new THREE.Vector3(p.x, p.y, z0);\n    const b = new THREE.Vector3(q.x, q.y, z0);\n    const c = new THREE.Vector3(q.x, q.y, z1);\n    const dd = new THREE.Vector3(p.x, p.y, z1);\n\n    const horizontal = Math.abs(p.y - q.y) < 1e-6;\n    const vertical = Math.abs(p.x - q.x) < 1e-6;\n    let mat = matRed;\n\n    if (horizontal && p.y > 1e-6 && q.x > p.x) mat = matGreen;\n    if (vertical && Math.max(p.x, q.x) >= pts[pts.length - 1].x - 1e-6) mat = matCyan;\n\n    objectGroup.add(quadMesh(a, b, c, dd, mat));\n  }\n\n  // Front cap (facing projection plane) = cyan/blue; back cap = cyan\n  addCap(pts, z0, matCyan);\n  addCap(pts, z1, matCyan);\n\n  // Apply rotation to pivot\n  applyObjectRotation(heights);\n}\n\nfunction buildProjectionFromRotated(heights) {\n  // Get world-space vertices and project onto XY plane\n  const worldVerts = getWorldVertices(heights);\n  const projPts2D = projectToPlane(worldVerts);\n\n  // Compute convex hull for the silhouette projection\n  const hull = convexHull2D(projPts2D);\n  if (hull.length < 3) return;\n\n  // Build filled silhouette on projection plane\n  const shape = new THREE.Shape(hull);\n  const matProjFill = new THREE.MeshBasicMaterial({\n    color: colors.cyan,\n    transparent: true,\n    opacity: 0.65,\n    side: THREE.DoubleSide,\n    depthWrite: false\n  });\n  const mesh = new THREE.Mesh(new THREE.ShapeGeometry(shape), matProjFill);\n  mesh.position.z = planeZ + 0.052;\n  mesh.renderOrder = 2;\n  projectionGroup.add(mesh);\n\n  // Outline of projection\n  const outline3D = hull.map(p => new THREE.Vector3(p.x, p.y, planeZ + 0.085));\n  outline3D.push(outline3D[0].clone());\n  projectionGroup.add(makeLine(outline3D, matBlack));\n\n  // Also draw the un-rotated silhouette outline for reference when rotated\n  // Draw the actual projected polygon (not just hull) to show step structure at 0 rotation\n  const cosA = Math.cos(state.objectRotation);\n  const sinA = Math.sin(state.objectRotation);\n  const center = computeObjectCenter(heights);\n\n  // Draw a colored overlay for the step shape as projected\n  // Show red region (vertical faces) and green region (horizontal top faces) projected\n  const pts = stepPolygon2D(heights, state.scale);\n  const z0 = state.objectDepth;\n  const z1 = state.objectDepth + objectLengthZ;\n\n  // Project individual faces onto plane to show colored regions\n  for (let i = 0; i < pts.length; i++) {\n    const p = pts[i];\n    const q = pts[(i + 1) % pts.length];\n    const a3 = localToWorld(new THREE.Vector3(p.x, p.y, z0), center);\n    const b3 = localToWorld(new THREE.Vector3(q.x, q.y, z0), center);\n    const c3 = localToWorld(new THREE.Vector3(q.x, q.y, z1), center);\n    const d3 = localToWorld(new THREE.Vector3(p.x, p.y, z1), center);\n\n    // Projected quad: use x,y of each rotated vertex\n    const pa = new THREE.Vector2(a3.x, a3.y);\n    const pb = new THREE.Vector2(b3.x, b3.y);\n    const pc = new THREE.Vector2(c3.x, c3.y);\n    const pd = new THREE.Vector2(d3.x, d3.y);\n\n    const horizontal = Math.abs(p.y - q.y) < 1e-6;\n    const vertical = Math.abs(p.x - q.x) < 1e-6;\n    let faceColor = colors.red;\n    if (horizontal && p.y > 1e-6 && q.x > p.x) faceColor = colors.green;\n    if (vertical && Math.max(p.x, q.x) >= pts[pts.length - 1].x - 1e-6) faceColor = colors.cyan;\n\n    const faceShape = new THREE.Shape([pa, pb, pc, pd]);\n    const faceMat = new THREE.MeshBasicMaterial({\n      color: faceColor,\n      transparent: true,\n      opacity: 0.55,\n      side: THREE.DoubleSide,\n      depthWrite: false\n    });\n    const faceMesh = new THREE.Mesh(new THREE.ShapeGeometry(faceShape), faceMat);\n    faceMesh.position.z = planeZ + 0.055;\n    faceMesh.renderOrder = 3;\n    projectionGroup.add(faceMesh);\n  }\n}\n\nfunction buildRaysFromRotated(heights) {\n  // Dashed rays connect projected points on plane to corresponding world-space vertices\n  const worldVerts = getWorldVertices(heights);\n\n  // Use a subset: the unique XY positions of world verts\n  const seen = new Set();\n  for (const wv of worldVerts) {\n    const px = wv.x.toFixed(3);\n    const py = wv.y.toFixed(3);\n    const key = `${px},${py}`;\n    if (seen.has(key)) continue;\n    seen.add(key);\n\n    // Ray from projection plane to the world vertex\n    const planePoint = new THREE.Vector3(wv.x, wv.y, planeZ + 0.13);\n    rayGroup.add(makeDashedLine(planePoint, wv));\n  }\n}\n\nfunction updateScene() {\n  clearGroup(objectGroup);\n  clearGroup(rayGroup);\n  clearGroup(projectionGroup);\n\n  const heights = heightsForShape();\n  buildObject(heights);\n  buildProjectionFromRotated(heights);\n  buildRaysFromRotated(heights);\n\n  uiDepth.value = state.objectDepth.toFixed(1);\n  uiScale.value = state.scale.toFixed(2);\n  uiShape.checked = state.altShape;\n  uiDepthValue.textContent = state.objectDepth.toFixed(1);\n  uiScaleValue.textContent = state.scale.toFixed(2);\n  uiRotation.value = Math.round(state.objectRotation * 180 / Math.PI);\n  uiRotationValue.textContent = Math.round(state.objectRotation * 180 / Math.PI) + '°';\n  uiAutoRotate.checked = state.autoRotate;\n}\n\nconst demoSteps = [\n  {\n    title: 'Starting point: default shape',\n    narration: 'A 3D step object is projected by parallel rays orthogonal to the projection plane. The colored footprint on the plane is its orthographic image.',\n    values: { objectDepth: 3, scale: 1, altShape: false, objectRotation: 0 }\n  },\n  {\n    title: 'Move object farther away',\n    narration: 'Increasing Z-depth moves the object along the ray direction. The dashed rays stay parallel, so the projected size and shape do not change.',\n    values: { objectDepth: 5, scale: 1, altShape: false, objectRotation: 0 }\n  },\n  {\n    title: 'Change global scale factor',\n    narration: 'Changing k applies a fixed global image scale in x = kX and y = kY. The projection grows uniformly while orthographic rays remain parallel.',\n    values: { objectDepth: 5, scale: 1.8, altShape: false, objectRotation: 0 }\n  },\n  {\n    title: 'Rotate object left/right (Y axis)',\n    narration: 'Rotating the stair around the Y (vertical) axis spins it left and right. The projection on the plane changes accordingly — showing how the silhouette changes with orientation.',\n    values: { objectDepth: 3, scale: 1, altShape: false, objectRotation: Math.PI / 4 }\n  }\n];\n\nlet tweenToken = 0;\nlet activeStep = 0;\n\nfunction setActiveStep(i) {\n  activeStep = i;\n  stepButtons.forEach((b, j) => b.classList.toggle('active', i === j));\n  if (demoSteps[i]) {\n    uiDemoTitle.textContent = demoSteps[i].title;\n    uiDemoNarration.textContent = demoSteps[i].narration;\n  }\n}\n\nfunction goToStep(i) {\n  const step = demoSteps[i];\n  if (!step) return;\n\n  setActiveStep(i);\n\n  const token = ++tweenToken;\n  const start = {\n    objectDepth: state.objectDepth,\n    scale: state.scale,\n    altShape: state.altShape,\n    objectRotation: state.objectRotation\n  };\n  const target = step.values;\n  const duration = 900;\n  const t0 = performance.now();\n\n  if (start.altShape !== target.altShape) state.altShape = target.altShape;\n\n  function tick(now) {\n    if (token !== tweenToken) return;\n\n    const u = Math.min((now - t0) / duration, 1);\n    const e = u < 0.5 ? 2 * u * u : 1 - Math.pow(-2 * u + 2, 2) / 2;\n\n    state.objectDepth = start.objectDepth + (target.objectDepth - start.objectDepth) * e;\n    state.scale = start.scale + (target.scale - start.scale) * e;\n    state.objectRotation = start.objectRotation + (target.objectRotation - start.objectRotation) * e;\n\n    updateScene();\n\n    if (u < 1) requestAnimationFrame(tick);\n  }\n\n  requestAnimationFrame(tick);\n}\n\nfunction markManualChange() {\n  stepButtons.forEach(b => b.classList.remove('active'));\n  uiDemoTitle.textContent = 'Manual exploration';\n  uiDemoNarration.textContent = 'Adjust controls independently. Use the rotation slider or Auto-spin to rotate the stair around the Y (vertical) axis — left and right. The projection updates accordingly.';\n}\n\nuiDepth.addEventListener('input', () => {\n  tweenToken++;\n  state.objectDepth = parseFloat(uiDepth.value);\n  markManualChange();\n  updateScene();\n});\n\nuiScale.addEventListener('input', () => {\n  tweenToken++;\n  state.scale = parseFloat(uiScale.value);\n  markManualChange();\n  updateScene();\n});\n\nuiShape.addEventListener('change', () => {\n  tweenToken++;\n  state.altShape = uiShape.checked;\n  markManualChange();\n  updateScene();\n});\n\nuiRotation.addEventListener('input', () => {\n  tweenToken++;\n  state.autoRotate = false;\n  uiAutoRotate.checked = false;\n  state.objectRotation = parseFloat(uiRotation.value) * Math.PI / 180;\n  uiRotationValue.textContent = uiRotation.value + '°';\n  markManualChange();\n  updateScene();\n});\n\nuiAutoRotate.addEventListener('change', () => {\n  state.autoRotate = uiAutoRotate.checked;\n  if (state.autoRotate) markManualChange();\n});\n\nstepButtons.forEach((btn, i) => btn.addEventListener('click', () => goToStep(i)));\nwindow.goToStep = goToStep;\n\nbuildStaticScene();\nupdateScene();\nsetActiveStep(0);\n\ncamera.position.set(-5.15, 3.35, 7.05);\ncontrols.target.set(0.92, 1.08, 2.85);\ncamera.zoom = 0.72;\ncamera.updateProjectionMatrix();\ncontrols.update();\n\nHOME_POS.copy(camera.position);\nHOME_TARGET.copy(controls.target);\nHOME_ZOOM = camera.zoom;\n// @FIGURE_CODE_END\n\n  </script>\n</body>\n\n</html>",
