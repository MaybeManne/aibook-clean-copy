  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n  <meta charset=\"UTF-8\" />\n  <title>Figure</title>\n  <style>\n    html,\n    body {\n      margin: 0;\n      padding: 0;\n      width: 100%;\n      height: 100%;\n      overflow: hidden;\n      background: #fff;\n    }\n\n    #c {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n\n    .lbl {\n      position: absolute;\n      pointer-events: none;\n      transform: translate(-50%, -50%);\n      white-space: nowrap;\n      font-family: sans-serif;\n      font-size: 13px;\n      color: #111;\n    }\n\n    #ui {\n      position: absolute;\n      left: 6px;\n      bottom: 6px;\n      display: flex;\n      flex-direction: column;\n      gap: 3px;\n      font-family: sans-serif;\n      font-size: 11px;\n      max-width: 190px;\n      max-height: 34%;\n      background: transparent;\n      border: 0;\n      box-shadow: none;\n      opacity: 0.88;\n      transform: none;\n      transition: opacity 0.16s ease;\n      z-index: 10;\n    }\n\n    #ui:hover,\n    #ui:focus-within {\n      opacity: 1;\n    }\n\n    #ui button {\n      padding: 4px 10px;\n      cursor: pointer;\n      border: 1px solid #aaa;\n      background: #f5f5f5;\n      border-radius: 4px;\n    }\n\n    #ui button:hover {\n      background: #e0e0e0;\n    }\n\n    #ui button.active {\n      background: #c8e6ff;\n      border-color: #5aabf0;\n    }\n\n    #ui label {\n      display: flex;\n      flex-direction: column;\n      gap: 2px;\n      text-shadow: 0 1px 2px #fff;\n    }\n\n    #ui input[type=range] {\n      width: 86px;\n    }\n\n    #figTooltip {\n      position: fixed;\n      left: 0;\n      top: 0;\n      display: none;\n      max-width: 210px;\n      padding: 4px 8px;\n      border-radius: 4px;\n      background: rgba(0, 0, 0, 0.58);\n      color: #fff;\n      font: 11px/1.35 sans-serif;\n      pointer-events: none;\n      white-space: normal;\n      z-index: 20;\n    }\n  </style>\n</head>\n\n<body>\n  <canvas id=\"c\"></canvas>\n  <div id=\"figTooltip\"></div>\n  <div id=\"ui\">\n    <button id=\"btnReset\" style=\"display:none\">Reset View</button>\n    <!-- @FIGURE_UI_BEGIN -->\n<label>Roughness\n  <input id=\"roughness\" type=\"range\" min=\"0\" max=\"1\" step=\"0.1\" value=\"1\">\n</label>\n<label>Angle\n  <input id=\"incidentAngle\" type=\"range\" min=\"10\" max=\"80\" step=\"5\" value=\"45\">\n</label>\n<!-- @FIGURE_UI_END -->\n  </div>\n\n  <script type=\"importmap\">\n  {\n    \"imports\": {\n      \"three\": \"https://cdn.jsdelivr.net/npm/three@0.171.0/build/three.module.js\",\n      \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@0.171.0/examples/jsm/\"\n    }\n  }\n  </script>\n\n  <div id=\"err-overlay\" style=\"display:none;position:fixed;inset:0;background:#fff;z-index:999;\n       display:flex;flex-direction:column;align-items:center;justify-content:center;\n       font-family:sans-serif;font-size:13px;color:#555;gap:10px;\">\n    <span id=\"err-msg\">⚠ Figure failed to load</span>\n    <button onclick=\"location.reload()\" style=\"padding:5px 14px;border:1px solid #aaa;\n        border-radius:5px;background:#f5f5f5;cursor:pointer;font-size:12px;\">↻ Reload</button>\n  </div>\n\n  <script>\n    let _rendered = false;\n    const _errOverlay = document.getElementById('err-overlay');\n    window.__markRendered = () => { _rendered = true; _errOverlay.style.display = 'none'; };\n    window.addEventListener('error', (e) => {\n      if (!_rendered) {\n        document.getElementById('err-msg').textContent = '⚠ ' + (e.message || 'Figure failed to load');\n        _errOverlay.style.display = 'flex';\n      }\n    });\n    setTimeout(() => {\n      if (!_rendered) { _errOverlay.style.display = 'flex'; }\n    }, 12000);\n  </script>\n\n  <script type=\"module\">\n    import * as THREE from 'three';\n    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';\n\n    const canvas = document.getElementById('c');\n    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });\n\n    const scene = new THREE.Scene();\n    scene.background = new THREE.Color(0xffffff);\n\n    const d = 3;\n    let aspect = canvas.clientWidth / canvas.clientHeight;\n    const camera = new THREE.OrthographicCamera(\n      -d * aspect, d * aspect, d, -d, 0.1, 100\n    );\n    camera.position.set(4, 4, 4);\n    camera.lookAt(0, 0, 0);\n    camera.updateProjectionMatrix();\n\n    const controls = new OrbitControls(camera, renderer.domElement);\n    controls.enableDamping = true;\n    controls.dampingFactor = 0.05;\n\n    const HOME_POS = new THREE.Vector3();\n    const HOME_TARGET = new THREE.Vector3(0, 0, 0);\n    let HOME_ZOOM = 0.75;\n\n    document.getElementById('btnReset').addEventListener('click', () => {\n      camera.position.copy(HOME_POS);\n      controls.target.copy(HOME_TARGET);\n      camera.zoom = HOME_ZOOM;\n      camera.updateProjectionMatrix();\n      controls.update();\n    });\n\n    const FRAME_HALF_HEIGHT = d;\n    const FRAME_MARGIN = 0.08;\n    const MIN_ZOOM = 0.2;\n    const MAX_ZOOM = 5;\n\n    function computeSceneBounds() {\n      const box = new THREE.Box3().setFromObject(scene);\n      if (box.isEmpty()) {\n        box.setFromCenterAndSize(new THREE.Vector3(0, 0, 0), new THREE.Vector3(2 * d, 2 * d, 2 * d));\n      }\n      const center = new THREE.Vector3();\n      box.getCenter(center);\n      const size = new THREE.Vector3();\n      box.getSize(size);\n      return { box, center, size };\n    }\n\n    function setStandardView({ azimuth = Math.PI / 4, polar = Math.PI / 4, heightFraction = 0.5 } = {}) {\n      const { center, size } = computeSceneBounds();\n      const contentHeight = Math.max(size.y, 1e-6);\n      const desiredViewHeight = contentHeight / Math.max(heightFraction, 0.01);\n      let zoom = (2 * FRAME_HALF_HEIGHT) / desiredViewHeight;\n      zoom = Math.min(Math.max(zoom, MIN_ZOOM), MAX_ZOOM);\n      camera.zoom = zoom;\n      const radius = Math.max(size.length() * 1.2, FRAME_HALF_HEIGHT * 2);\n      const sinPhi = Math.sin(polar), cosPhi = Math.cos(polar);\n      const x = center.x + radius * Math.cos(azimuth) * sinPhi;\n      const y = center.y + radius * cosPhi;\n      const z = center.z + radius * Math.sin(azimuth) * sinPhi;\n      camera.position.set(x, y, z);\n      controls.target.copy(center);\n      camera.updateProjectionMatrix();\n      controls.update();\n      HOME_POS.copy(camera.position);\n      HOME_TARGET.copy(controls.target);\n      HOME_ZOOM = camera.zoom;\n    }\n\n    setStandardView();\n\n    const _labels = [];\n    const _v = new THREE.Vector3();\n\n    function addLabel(text, position, options = {}) {\n      const div = document.createElement('div');\n      div.className = 'lbl';\n      div.innerHTML = text;\n      if (options.color) div.style.color = options.color;\n      if (options.fontSize) div.style.fontSize = options.fontSize;\n      if (options.bold) div.style.fontWeight = 'bold';\n      if (options.background) {\n        div.style.background = options.background;\n        div.style.padding = '1px 4px';\n        div.style.borderRadius = '3px';\n      }\n      document.body.appendChild(div);\n      const entry = { div, pos: position.clone(), offset: options.offset || [0, 0] };\n      _labels.push(entry);\n      return entry;\n    }\n\n    const _referenceDistance = 8;\n\n    function _syncLabels() {\n      for (const { div, pos, offset } of _labels) {\n        _v.copy(pos).project(camera);\n        if (_v.z > 1 || _v.z < -1 || _v.x < -1 || _v.x > 1 || _v.y < -1 || _v.y > 1) {\n          div.style.display = 'none';\n          continue;\n        }\n        div.style.display = '';\n        const ox = offset && offset[0] ? offset[0] : 0;\n        const oy = offset && offset[1] ? offset[1] : 0;\n        const x = (_v.x * 0.5 + 0.5) * canvas.clientWidth + ox;\n        const y = (-_v.y * 0.5 + 0.5) * canvas.clientHeight + oy;\n        let scale;\n        const distance = Math.max(camera.position.distanceTo(pos), 1e-4);\n        scale = (_referenceDistance / distance) * (camera.zoom || 1);\n        scale = Math.max(0.5, Math.min(scale, 6));\n        div.style.left = x + 'px';\n        div.style.top = y + 'px';\n        div.style.transform = `translate(-50%, -50%) scale(${scale})`;\n      }\n    }\n\n    const _tooltip = document.getElementById('figTooltip');\n    const _raycaster = new THREE.Raycaster();\n    const _pointer = new THREE.Vector2();\n    const _interactiveObjects = [];\n    let _hoveredInteractive = null;\n\n    function showPopup(title, body) {\n      window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n    }\n\n    function hidePopup() {\n      window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n    }\n\n    function showTooltip(text, event) {\n      if (!_tooltip || !text) return;\n      _tooltip.textContent = text;\n      _tooltip.style.display = 'block';\n      moveTooltip(event);\n    }\n\n    function moveTooltip(event) {\n      if (!_tooltip || _tooltip.style.display === 'none') return;\n      const pad = 12;\n      const x = Math.min(event.clientX + pad, window.innerWidth - _tooltip.offsetWidth - pad);\n      const y = Math.max(pad, event.clientY - _tooltip.offsetHeight - pad);\n      _tooltip.style.left = x + 'px';\n      _tooltip.style.top = y + 'px';\n    }\n\n    function hideTooltip() {\n      if (_tooltip) _tooltip.style.display = 'none';\n    }\n\n    function _setPointerFromEvent(event) {\n      const rect = canvas.getBoundingClientRect();\n      _pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;\n      _pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;\n    }\n\n    function _firstInteractiveHit(event) {\n      if (!_interactiveObjects.length) return null;\n      _setPointerFromEvent(event);\n      _raycaster.setFromCamera(_pointer, camera);\n      const hits = _raycaster.intersectObjects(_interactiveObjects.map(entry => entry.object), true);\n      for (const hit of hits) {\n        let obj = hit.object;\n        while (obj) {\n          const entry = _interactiveObjects.find(item => item.object === obj);\n          if (entry) return { ...entry, hit };\n          obj = obj.parent;\n        }\n      }\n      return null;\n    }\n\n    function registerInteractive(object, info = {}) {\n      if (!object) return object;\n      object.userData = object.userData || {};\n      object.userData.interactive = true;\n      _interactiveObjects.push({ object, info });\n      return object;\n    }\n\n    canvas.addEventListener('pointermove', (event) => {\n      moveTooltip(event);\n      const entry = _firstInteractiveHit(event);\n      if (entry) {\n        _hoveredInteractive = entry;\n        canvas.style.cursor = 'pointer';\n        showTooltip(entry.info.tooltip || entry.info.title || 'Click to explain', event);\n      } else {\n        _hoveredInteractive = null;\n        canvas.style.cursor = controls.enabled ? 'grab' : 'default';\n        hideTooltip();\n      }\n    });\n\n    canvas.addEventListener('pointerleave', () => {\n      _hoveredInteractive = null;\n      canvas.style.cursor = 'default';\n      hideTooltip();\n    });\n\n    canvas.addEventListener('click', (event) => {\n      const entry = _firstInteractiveHit(event) || _hoveredInteractive;\n      if (!entry) {\n        hidePopup();\n        return;\n      }\n      const title = entry.info.title || entry.info.tooltip || 'Figure element';\n      const body = entry.info.body || entry.info.description || 'This part is interactive.';\n      showPopup(title, body);\n      if (typeof entry.info.onClick === 'function') entry.info.onClick(entry.hit, entry.object);\n    });\n\n    window.addEventListener('keydown', (event) => {\n      if (event.key === 'Escape') {\n        hidePopup();\n        hideTooltip();\n      }\n    });\n\n    let _firstFrame = true;\n    function animate() {\n      requestAnimationFrame(animate);\n      controls.update();\n      renderer.render(scene, camera);\n      _syncLabels();\n      if (_firstFrame) { _firstFrame = false; window.__markRendered?.(); }\n    }\n    animate();\n\n    new ResizeObserver(() => {\n      const w = canvas.clientWidth, h = canvas.clientHeight;\n      aspect = w / h;\n      camera.left = -d * aspect;\n      camera.right = d * aspect;\n      camera.updateProjectionMatrix();\n      renderer.setSize(w, h, false);\n    }).observe(canvas);\n\n    // @FIGURE_CODE_BEGIN\n\n    const fig = new THREE.Group();\n    scene.add(fig);\n\n    const state = {\n      roughness: 1,\n      incidentAngle: 45,\n      stepIndex: 0\n    };\n\n    const uiRough = document.getElementById('roughness');\n    const uiAngle = document.getElementById('incidentAngle');\n\n    const planeW = 8.6;\n    const planeD = 5.4;\n\n    const greenFill = new THREE.MeshBasicMaterial({ color: 0x72ff00, side: THREE.DoubleSide });\n\n    function makeQuadGeometry(w, d) {\n      const g = new THREE.BufferGeometry();\n      const hw = w / 2, hd = d / 2;\n      const pts = new Float32Array([\n        -hw, 0, -hd,\n         hw, 0, -hd,\n         hw, 0,  hd,\n        -hw, 0,  hd\n      ]);\n      g.setAttribute('position', new THREE.BufferAttribute(pts, 3));\n      g.setIndex([0, 1, 2, 0, 2, 3]);\n      g.computeVertexNormals();\n      return g;\n    }\n\n    const planeMesh = new THREE.Mesh(makeQuadGeometry(planeW, planeD), greenFill);\n    fig.add(planeMesh);\n\n    // Thin border using LineLoop\n    const hw = planeW / 2, hd = planeD / 2;\n    const borderPts = [\n      new THREE.Vector3(-hw, 0, -hd),\n      new THREE.Vector3( hw, 0, -hd),\n      new THREE.Vector3( hw, 0,  hd),\n      new THREE.Vector3(-hw, 0,  hd),\n    ];\n    const borderLoop = new THREE.LineLoop(\n      new THREE.BufferGeometry().setFromPoints(borderPts),\n      new THREE.LineBasicMaterial({ color: 0x111111, linewidth: 1 })\n    );\n    fig.add(borderLoop);\n\n    const hitPoint = new THREE.Vector3(0.1, 0.02, 0.1);\n\n    const ring = new THREE.Mesh(\n      new THREE.RingGeometry(0.13, 0.23, 48),\n      new THREE.MeshBasicMaterial({ color: 0x333333, side: THREE.DoubleSide, transparent: true, opacity: 0.9 })\n    );\n    ring.rotation.x = -Math.PI / 2;\n    ring.position.copy(hitPoint);\n    fig.add(ring);\n\n    const normalGroup = new THREE.Group();\n    fig.add(normalGroup);\n\n    function makeArrowGroup(color, shaftRadius = 0.04, headRadius = 0.11, headLength = 0.24) {\n      const g = new THREE.Group();\n      const shaft = new THREE.Mesh(\n        new THREE.CylinderGeometry(shaftRadius, shaftRadius, 1, 12),\n        new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 1 })\n      );\n      shaft.position.y = 0.5;\n      g.add(shaft);\n      const head = new THREE.Mesh(\n        new THREE.ConeGeometry(headRadius, headLength, 18),\n        new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 1 })\n      );\n      head.position.y = 1 + headLength * 0.5 - 0.02;\n      g.add(head);\n      g.userData.shaft = shaft;\n      g.userData.head = head;\n      g.userData.headLength = headLength;\n      return g;\n    }\n\n    function placeArrow(group, base, dir, len) {\n      const nDir = dir.clone().normalize();\n      group.position.copy(base);\n      group.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), nDir);\n      const shaftLen = Math.max(0.001, len - group.userData.headLength * 0.8);\n      group.userData.shaft.scale.set(1, shaftLen, 1);\n      group.userData.shaft.position.y = shaftLen * 0.5;\n      group.userData.head.position.y = shaftLen + group.userData.headLength * 0.5 - 0.01;\n    }\n\n    const normalArrow = makeArrowGroup(0x111111, 0.045, 0.14, 0.30);\n    normalGroup.add(normalArrow);\n\n    const rightAnglePts = [\n      new THREE.Vector3(0.18, 0.02, 0.00),\n      new THREE.Vector3(0.18, 0.32, 0.00),\n      new THREE.Vector3(0.38, 0.32, 0.00),\n      new THREE.Vector3(0.38, 0.02, 0.00)\n    ];\n    const rightAngle = new THREE.Line(\n      new THREE.BufferGeometry().setFromPoints(rightAnglePts),\n      new THREE.LineBasicMaterial({ color: 0x111111 })\n    );\n    rightAngle.position.copy(hitPoint);\n    normalGroup.add(rightAngle);\n\n    placeArrow(normalArrow, hitPoint, new THREE.Vector3(0, 1, 0), 1.2);\n\n    // ── Thick incident ray using a gradient-colored tube ──────────────────\n    const incidentTubeGroup = new THREE.Group();\n    fig.add(incidentTubeGroup);\n\n    let incidentTubeMesh = null;\n    let incidentStart = new THREE.Vector3();\n\n    function buildIncidentTube(start, end) {\n      if (incidentTubeMesh) {\n        incidentTubeGroup.remove(incidentTubeMesh);\n        incidentTubeMesh.geometry.dispose();\n      }\n\n      const dir = new THREE.Vector3().subVectors(end, start);\n      const len = dir.length();\n      const mid = new THREE.Vector3().addVectors(start, end).multiplyScalar(0.5);\n\n      const segments = 20;\n      const geom = new THREE.CylinderGeometry(0.09, 0.09, len, 12, segments);\n\n      const posAttr = geom.attributes.position;\n      const colors = new Float32Array(posAttr.count * 3);\n      const colorAttr = new THREE.BufferAttribute(colors, 3);\n\n      for (let i = 0; i < posAttr.count; i++) {\n        const y = posAttr.getY(i);\n        const t = (y / len + 0.5);\n        colors[i * 3 + 0] = 1.0;\n        colors[i * 3 + 1] = 0.35 + t * 0.65;\n        colors[i * 3 + 2] = t * 0.05;\n      }\n      geom.setAttribute('color', colorAttr);\n\n      incidentTubeMesh = new THREE.Mesh(\n        geom,\n        new THREE.MeshBasicMaterial({ vertexColors: true })\n      );\n      incidentTubeMesh.position.copy(mid);\n      incidentTubeMesh.quaternion.setFromUnitVectors(\n        new THREE.Vector3(0, 1, 0),\n        dir.clone().normalize()\n      );\n      incidentTubeGroup.add(incidentTubeMesh);\n    }\n\n    const pArrow = new THREE.Mesh(\n      new THREE.ConeGeometry(0.18, 0.38, 18),\n      new THREE.MeshBasicMaterial({ color: 0xff3b2f })\n    );\n    fig.add(pArrow);\n\n    const qColor = 0x0d8f09;\n    const qArrow = makeArrowGroup(qColor, 0.04, 0.14, 0.28);\n    fig.add(qArrow);\n\n    const sprayGroup = new THREE.Group();\n    fig.add(sprayGroup);\n\n    // Build spray arrows matching the original figure:\n    // The original shows arrows radiating in ALL directions from the hit point -\n    // both above the surface (hemisphere) AND along/below the surface plane.\n    // They fan out like a starburst in multiple rings.\n    const sprayArrows = [];\n\n    // Ring 1: arrows going outward mostly along the surface plane (low elevation)\n    // These appear in the original spreading across the green surface\n    const surfaceRingAngles = [0, 30, 60, 90, 120, 150, 180, 210, 240, 270, 300, 330];\n    for (const phiDeg of surfaceRingAngles) {\n      const phi = THREE.MathUtils.degToRad(phiDeg);\n      // Very low elevation - nearly flat on the surface\n      const theta = THREE.MathUtils.degToRad(82);\n      const dir = new THREE.Vector3(\n        Math.sin(theta) * Math.cos(phi),\n        Math.cos(theta),\n        Math.sin(theta) * Math.sin(phi)\n      ).normalize();\n      const arrow = makeArrowGroup(0x45d80d, 0.025, 0.09, 0.20);\n      sprayGroup.add(arrow);\n      sprayArrows.push({ arrow, dir, isSurface: true });\n    }\n\n    // Ring 2: mid-elevation arrows (above surface, moderate angle)\n    const midRingPhis = [0, 45, 90, 135, 180, 225, 270, 315];\n    for (const phiDeg of midRingPhis) {\n      const phi = THREE.MathUtils.degToRad(phiDeg);\n      const theta = THREE.MathUtils.degToRad(55);\n      const dir = new THREE.Vector3(\n        Math.sin(theta) * Math.cos(phi),\n        Math.cos(theta),\n        Math.sin(theta) * Math.sin(phi)\n      ).normalize();\n      const arrow = makeArrowGroup(0x45d80d, 0.025, 0.09, 0.20);\n      sprayGroup.add(arrow);\n      sprayArrows.push({ arrow, dir, isSurface: false });\n    }\n\n    // Ring 3: higher elevation arrows\n    const highRingPhis = [0, 60, 120, 180, 240, 300];\n    for (const phiDeg of highRingPhis) {\n      const phi = THREE.MathUtils.degToRad(phiDeg);\n      const theta = THREE.MathUtils.degToRad(28);\n      const dir = new THREE.Vector3(\n        Math.sin(theta) * Math.cos(phi),\n        Math.cos(theta),\n        Math.sin(theta) * Math.sin(phi)\n      ).normalize();\n      const arrow = makeArrowGroup(0x45d80d, 0.025, 0.09, 0.20);\n      sprayGroup.add(arrow);\n      sprayArrows.push({ arrow, dir, isSurface: false });\n    }\n\n    function reflectDir(incidentTowardSurface, normal) {\n      return incidentTowardSurface.clone().reflect(normal).normalize();\n    }\n\n    function setMeshOpacity(group, opacity) {\n      group.traverse(obj => {\n        if (obj.material) {\n          obj.material.opacity = opacity;\n          obj.material.transparent = opacity < 1;\n        }\n      });\n    }\n\n    function updateIncident() {\n      const a = THREE.MathUtils.degToRad(state.incidentAngle);\n      const dirTowardSurface = new THREE.Vector3(-Math.sin(a), -Math.cos(a), -0.28).normalize();\n      const len = 5.4;\n      incidentStart.copy(hitPoint).sub(dirTowardSurface.clone().multiplyScalar(len));\n\n      buildIncidentTube(incidentStart, hitPoint);\n\n      const tipDir = dirTowardSurface.clone();\n      pArrow.position.copy(hitPoint).sub(tipDir.clone().multiplyScalar(0.20));\n      pArrow.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), tipDir.clone().normalize());\n      pArrow.rotateX(Math.PI);\n\n      const refl = reflectDir(dirTowardSurface, new THREE.Vector3(0, 1, 0));\n      placeArrow(qArrow, hitPoint, refl, 3.0);\n\n      return { incoming: dirTowardSurface, reflected: refl };\n    }\n\n    function lobeStrength(outDir, reflected, roughness, ndotl) {\n      const diffuse = Math.max(0, outDir.y) * ndotl;\n      if (roughness >= 0.999) return diffuse;\n      const rr = Math.max(roughness, 0.0001);\n      const specPow = Math.max(8, Math.round(2 / rr));\n      const spec = Math.pow(Math.max(0, outDir.dot(reflected)), specPow) * ndotl;\n      const blend = 1 - rr;\n      if (rr <= 0.001) return spec > 0.88 * ndotl ? spec * 1.2 : 0;\n      return diffuse * rr + spec * blend * 1.35;\n    }\n\n    function updateSpray() {\n      const { incoming, reflected } = updateIncident();\n      const ndotp = Math.max(0, -incoming.dot(new THREE.Vector3(0, 1, 0)));\n\n      for (const s of sprayArrows) {\n        if (s.isSurface) {\n          // Surface-plane arrows: always visible at fixed short length for the starburst look\n          const len = 0.85 * (0.5 + 0.5 * state.roughness);\n          placeArrow(s.arrow, hitPoint, s.dir, len);\n          const opacity = 0.45 * state.roughness + 0.15;\n          setMeshOpacity(s.arrow, opacity);\n          s.arrow.visible = state.roughness > 0.05;\n        } else {\n          const val = lobeStrength(s.dir, reflected, state.roughness, ndotp);\n          let len = 0.2 + 1.5 * Math.min(1, val);\n          if (state.roughness <= 0.02) len *= 0.15;\n          placeArrow(s.arrow, hitPoint, s.dir, len);\n          const opacity = THREE.MathUtils.clamp(0.12 + val * 1.3, 0.08, 0.75);\n          setMeshOpacity(s.arrow, opacity);\n          s.arrow.visible = val > 0.025 && !(state.roughness <= 0.02 && val < 0.5);\n        }\n      }\n\n      qArrow.visible = true;\n      const qOpacity = state.roughness <= 0.05 ? 1 : 0.9;\n      setMeshOpacity(qArrow, qOpacity);\n\n      if (state.roughness <= 0.001) {\n        for (const s of sprayArrows) s.arrow.visible = false;\n        placeArrow(qArrow, hitPoint, reflected, 3.0);\n      }\n\n      return { incoming, reflected, ndotp };\n    }\n\n    // ── Labels ────────────────────────────────────────────────────────────\n    const linLabel  = addLabel('ℓ<sub>in</sub>(λ)', new THREE.Vector3(-1.4, 3.05, -1.2), { fontSize: '36px' });\n    const loutLabel = addLabel('ℓ<sub>out</sub>=F(ℓ<sub>in</sub>, <b>n</b>, λ, <b>p</b>, <b>q</b>)', new THREE.Vector3(3.4, 2.65, -0.1), { fontSize: '34px' });\n    const pLabel    = addLabel('<b>p</b>', hitPoint.clone().add(new THREE.Vector3(-0.95, 0.95, -0.12)), { fontSize: '34px' });\n    const nLabel    = addLabel('<b>n</b>', hitPoint.clone().add(new THREE.Vector3(-0.25, 1.35, 0.0)), { fontSize: '34px' });\n    const qLabel    = addLabel('<b>q</b>', hitPoint.clone().add(new THREE.Vector3(0.95, 0.95, 0.18)), { fontSize: '34px' });\n\n    function updateLabelPositions(incoming, reflected) {\n      const linPos = incidentStart.clone().lerp(hitPoint, 0.18);\n      linLabel.pos.copy(linPos);\n\n      const qTipPos = hitPoint.clone().add(reflected.clone().multiplyScalar(3.1));\n      loutLabel.pos.copy(qTipPos).add(new THREE.Vector3(0.3, 0.15, 0));\n\n      const pDir = incoming.clone().normalize();\n      pLabel.pos.copy(hitPoint)\n        .sub(pDir.clone().multiplyScalar(0.6))\n        .add(new THREE.Vector3(-0.35, 0.2, 0));\n\n      nLabel.pos.copy(hitPoint).add(new THREE.Vector3(0.0, 1.35, 0.0));\n\n      qLabel.pos.copy(hitPoint)\n        .add(reflected.clone().multiplyScalar(1.0))\n        .add(new THREE.Vector3(0.25, 0.0, 0));\n    }\n\n    function updateScene() {\n      state.roughness = parseFloat(uiRough.value);\n      state.incidentAngle = parseFloat(uiAngle.value);\n      const info = updateSpray();\n      updateLabelPositions(info.incoming, info.reflected);\n    }\n\n    uiRough.addEventListener('input', updateScene);\n    uiAngle.addEventListener('input', updateScene);\n\n    const stepDefs = [\n      {\n        title: 'Lambertian Reflection',\n        narration: 'In a perfect Lambertian surface, light is scattered broadly across the visible hemisphere. The outgoing intensity is independent of viewing direction q, aside from the common cosine falloff set by the surface orientation relative to the source.',\n        control_values: { roughness: 1, incidentAngle: 45 }\n      },\n      {\n        title: 'The Cosine Law',\n        narration: 'Tilting the incoming ray toward the horizon reduces the irradiance by the factor n · p. The whole reflection spray shrinks together because less energy reaches each unit area of the surface.',\n        control_values: { roughness: 1, incidentAngle: 75 }\n      },\n      {\n        title: 'Glossy Reflection Lobe',\n        narration: 'As roughness decreases, the diffuse spray contracts into a directional lobe around the mirror-reflection direction. Now the outgoing brightness depends strongly on whether q lies near that lobe.',\n        control_values: { roughness: 0.3, incidentAngle: 45 }\n      },\n      {\n        title: 'Perfect Mirror Specular',\n        narration: 'At zero roughness, the reflected energy collapses into a single specular direction. Only viewers aligned with the exact reflection ray receive light.',\n        control_values: { roughness: 0, incidentAngle: 45 }\n      }\n    ];\n\n    function tweenControl(input, target, duration = 700) {\n      const start = parseFloat(input.value);\n      const t0 = performance.now();\n      function step(t) {\n        const u = Math.min(1, (t - t0) / duration);\n        const e = u < 0.5 ? 2 * u * u : 1 - Math.pow(-2 * u + 2, 2) / 2;\n        input.value = (start + (target - start) * e).toFixed(3);\n        updateScene();\n        if (u < 1) requestAnimationFrame(step);\n      }\n      requestAnimationFrame(step);\n    }\n\n    window.goToStep = function(i) {\n      const step = stepDefs[i];\n      if (!step) return;\n      state.stepIndex = i;\n      tweenControl(uiRough, step.control_values.roughness, 850);\n      tweenControl(uiAngle, step.control_values.incidentAngle, 850);\n      showPopup(step.title, step.narration);\n    };\n\n    registerInteractive(planeMesh, {\n      title: 'Reflecting surface',\n      tooltip: 'Surface BRDF',\n      body: 'This green plane represents the material surface. Its BRDF maps incoming light direction p into outgoing light over the hemisphere above the surface, with the normal n defining the local orientation.'\n    });\n\n    registerInteractive(normalArrow, {\n      title: 'Surface normal n',\n      tooltip: 'Surface normal',\n      body: 'The normal vector is perpendicular to the surface and sets the reference for all lighting angles. In Lambertian reflection, brightness scales with the cosine of the angle between the normal and the incoming light direction.'\n    });\n\n    registerInteractive(qArrow, {\n      title: 'Outgoing direction q',\n      tooltip: 'Outgoing ray q',\n      body: 'This highlighted green arrow marks one outgoing viewing direction q. For a diffuse Lambertian surface, the radiance is independent of q; for glossy or mirror-like reflection, q must align with the reflection lobe to receive strong light.'\n    });\n\n    registerInteractive(sprayGroup, {\n      title: 'Reflection distribution',\n      tooltip: 'Reflection spray / BRDF lobe',\n      body: 'The green spray visualizes how reflected light is distributed over outgoing directions. High roughness gives a broad diffuse hemisphere, while low roughness concentrates energy near the specular reflection direction.'\n    });\n\n    // ── Camera: match the original image viewpoint ───────────────────────\n    controls.target.set(0.2, 0.1, 0.0);\n    const azDeg = -155;\n    const elDeg = 22;\n    const camRadius = 14;\n    const azRad = THREE.MathUtils.degToRad(azDeg);\n    const elRad = THREE.MathUtils.degToRad(elDeg);\n    camera.position.set(\n      controls.target.x + camRadius * Math.cos(elRad) * Math.sin(azRad),\n      controls.target.y + camRadius * Math.sin(elRad),\n      controls.target.z + camRadius * Math.cos(elRad) * Math.cos(azRad)\n    );\n    camera.zoom = 0.72;\n    camera.updateProjectionMatrix();\n    controls.update();\n\n    HOME_POS.copy(camera.position);\n    HOME_TARGET.copy(controls.target);\n    HOME_ZOOM = camera.zoom;\n\n    document.getElementById('btnReset').style.display = '';\n    updateScene();\n    // @FIGURE_CODE_END\n\n  </script>\n</body>\n\n</html>",
